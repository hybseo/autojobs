# 기계가 만드는 파일은 저장소에 올리지 않습니다.
#
# 여기 적힌 것들은 소스가 아니라 "돌리면 생기는 것"입니다. 올려 두면
# 돌릴 때마다 내용이 바뀌어 쓸데없는 변경 기록이 쌓이고, 사람이 쓴
# 코드가 그 사이에 묻힙니다.
#
# 2026-10-12 에 만들었습니다. 그전에는 이 파일이 없어서, 파이썬을 한 번
# 돌릴 때마다 __pycache__ 가 "올려야 할 파일" 처럼 보였습니다.

# ── 파이썬 ────────────────────────────────────────────
# .pyc 는 파이썬이 스크립트를 빠르게 다시 읽으려고 만들어 두는
# 번역본입니다. 파이썬 판이 바뀌면 이름도 바뀝니다.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── 자바스크립트 / 아스트로 ───────────────────────────
# node_modules 는 package.json 만 있으면 언제든 다시 받을 수 있습니다.
# 수만 개 파일이라 올리면 저장소가 감당이 안 됩니다.
node_modules/

# dist 는 사이트를 지은 결과물입니다. 클라우드플레어가 올릴 때마다
# 직접 짓기 때문에 저장소에 둘 이유가 없습니다.
dist/
.astro/
.wrangler/

# ── 운영체제가 멋대로 만드는 것 ───────────────────────
.DS_Store
Thumbs.db

# ── 임시 파일 ─────────────────────────────────────────
*.log
*.tmp
