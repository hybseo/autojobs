---
import { daysLeft, progress, isAlways, sortValue, industriesOf, rolesOf, roleName, searchAlias, hasDetail } from '../lib.js';
const { job, href } = Astro.props;
const d = daysLeft(job);
const p = progress(job);
const always = isAlways(job);
// 마감일이 없으면 daysLeft 가 Infinity 입니다.
// data 속성에 Infinity 를 넣으면 클라이언트 정렬에서 NaN 이 되므로 유한한 값을 씁니다.
const sv = sortValue(job);
const cls = always ? 'd-far' : d <= 3 ? 'd-urgent' : d <= 7 ? 'd-warn' : 'd-far';
const label = p === null ? '상시' : d <= 0 ? '오늘 마감' : `D-${d}`;
const urgent = !always && d <= 3;
const md = (s) => s.slice(5).replace('-', '.');
// 한 회사가 여러 산업에 걸칩니다. 그 공고는 양쪽 필터에 모두 걸려야 합니다.
const indList = industriesOf(job);
const inds = indList.join('|');
/*
 * 색은 주 산업(첫 번째) 하나로만 칠합니다.
 *
 * data-in 에 여러 산업이 들어가면 CSS 속성 선택자가 여러 개 걸리고,
 * 나중에 선언된 것이 이깁니다. 42dot 은 자동차부품인데 IT 색이 붙는 식입니다.
 * 그래서 주 산업만 따로 넘깁니다.
 */
const mainInd = indList[0] || '';
/*
 * 직무.
 *
 * 제목과 본문에서 읽어낸 것이라 없을 수도 있습니다(장학생 선발, 그룹 공채처럼
 * 직무가 정해지지 않은 공고). 그때는 빈 문자열이 되어 어느 직무 필터에도
 * 걸리지 않습니다. 억지로 붙이지 않습니다.
 */
const roleList = rolesOf(job);
const roleCodes = roleList.join('|');
const roleNames = roleList.map(roleName).join(' ');
// 본문이 있는 포지션 단위 공고만 자체 상세 페이지를 가집니다.
// 판정은 lib.js 의 hasDetail 하나로 합니다. 여기서 직접 비교하면
// 페이지 생성 조건과 어긋나 404 가 납니다(2026-10-10 컴투스 사례).
const link = href ?? (hasDetail(job) ? `/job/${job.id}/` : job.sourceUrl);
const external = link === job.sourceUrl;
---
<a class="card" href={link} data-co={job.company} data-career={job.career}
   data-op={always ? '상시채용' : '마감 있음'} data-in={inds} data-ind={mainInd}
   data-role={roleCodes}
   data-dday={sv} data-posted={job.postedAt || ''} data-text={`${job.title} ${job.company} ${searchAlias(job.company)} ${job.location} ${job.sourceTitle} ${roleNames}`.toLowerCase()}
   {...external ? { target: '_blank', rel: 'noopener' } : {}}>
  <div class="chead">
    <span class="co">{job.company}</span>
    <span class:list={['dday', cls]}>{label}</span>
  </div>
  <div class="ttl">{job.title}</div>
  <div class="facts">
    {job.location && <span class="f">{job.location}</span>}
    <span class="f">{job.career}</span>
    {job.multiRole && <span class="f multi">여러 직무 포함 가능</span>}
    {/*
      본문이 없는 공고는 누르면 회사 사이트로 바로 나갑니다.
      같은 목록에 섞여 있어서 미리 알려주지 않으면 새 탭이 갑자기 열립니다.
    */}
    {external && <span class="f ext">원문 사이트 ↗</span>}
  </div>
  {job.sourceTitle && <div class="src">{job.sourceTitle}</div>}
  {p === null ? (
    <div class="gauge"><span class="g-open">상시 접수 · 마감일 미정</span></div>
  ) : (
    <div class="gauge">
      <span class="g-date">{md(job.postedAt)}</span>
      <span class="g-track">
        <span class:list={['g-fill', urgent && 'urgent']} style={`--p:${p.toFixed(3)}`}></span>
        <span class:list={['g-dot', urgent && 'urgent']} style={`left:${(p * 100).toFixed(1)}%`}></span>
      </span>
      <span class="g-date">{md(job.closesAt)} 마감</span>
    </div>
  )}
</a>

{/*
  이 파일에는 <style> 을 두지 않습니다 (2026-10-14)
  ---------------------------------------------------
  아스트로는 컴포넌트에 <style> 이 있으면 그 스타일이 다른 곳에 새지
  않도록, 그 컴포넌트가 만드는 모든 요소에 표식을 하나씩 붙입니다.

      <span class="co" data-astro-cid-thris56x>

  카드 한 장에 요소가 여덟아홉 개이고 홈에 카드가 5,151장이니, 이
  표식만 54,912번 붙어 1,287KB 가 됐습니다. 홈 전체 5,040KB 의 25%
  입니다. 규칙은 .facts .f.ext 딱 하나였는데 말입니다.

  그래서 그 한 줄을 src/styles/global.css 로 옮기고 여기서는 <style>
  을 없앴습니다. 화면은 똑같고 표식만 사라집니다.

  카드 모양을 고칠 일이 생기면 global.css 의 .card 부근을 고치세요.
  여기에 <style> 을 다시 만들면 1,287KB 가 그대로 돌아옵니다.

  왜 그게 문제였나: 네이버 검색로봇이 5,040KB 짜리 홈을 읽지 못해
  "접근할 수 없습니다" 로 보고했습니다. 같은 사이트의 2,584KB 짜리
  산업 페이지는 정상적으로 읽었습니다.
*/}
