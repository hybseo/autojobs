---
import { daysLeft, progress, isAlways, sortValue, industriesOf } from '../lib.js';
const { job, href } = Astro.props;
const d = daysLeft(job);
const p = progress(job);
const always = isAlways(job);
// 마감일이 없으면 daysLeft 가 Infinity 입니다.
// data 속성에 Infinity 를 넣으면 클라이언트 정렬에서 NaN 이 되므로 유한한 값을 씁니다.
const sv = sortValue(job);
const cls = always ? 'd-far' : d <= 3 ? 'd-urgent' : d <= 7 ? 'd-warn' : 'd-far';
const label = p === null ? '상시' : d <= 0 ? '오늘 마감' : `D-${d}`;
const urgent = !always && d <= 3;
const md = (s) => s.slice(5).replace('-', '.');
// 한 회사가 여러 산업에 걸칩니다. 그 공고는 양쪽 필터에 모두 걸려야 합니다.
const inds = industriesOf(job).join('|');
// 본문이 있는 포지션 단위 공고만 자체 상세 페이지를 가집니다.
const link = href ?? (job.description ? `/job/${job.id}/` : job.sourceUrl);
const external = link === job.sourceUrl;
---
<a class="card" href={link} data-co={job.company} data-career={job.career}
   data-op={always ? '상시채용' : '마감 있음'} data-in={inds}
   data-dday={sv} data-text={`${job.title} ${job.company} ${job.location} ${job.sourceTitle}`.toLowerCase()}
   {...external ? { target: '_blank', rel: 'noopener' } : {}}>
  <div class="chead">
    <span class="co">{job.company}</span>
    <span class:list={['dday', cls]}>{label}</span>
  </div>
  <div class="ttl">{job.title}</div>
  <div class="facts">
    {job.location && <span class="f">{job.location}</span>}
    <span class="f">{job.career}</span>
    {job.multiRole && <span class="f multi">여러 직무 포함 가능</span>}
  </div>
  {job.sourceTitle && <div class="src">{job.sourceTitle}</div>}
  {p === null ? (
    <div class="gauge"><span class="g-open">상시 접수 · 마감일 미정</span></div>
  ) : (
    <div class="gauge">
      <span class="g-date">{md(job.postedAt)}</span>
      <span class="g-track">
        <span class:list={['g-fill', urgent && 'urgent']} style={`--p:${p.toFixed(3)}`}></span>
        <span class:list={['g-dot', urgent && 'urgent']} style={`left:${(p * 100).toFixed(1)}%`}></span>
      </span>
      <span class="g-date">{md(job.closesAt)} 마감</span>
    </div>
  )}
</a>
