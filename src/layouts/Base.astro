---
import '../styles/global.css';
import { ldJson } from '../lib.js';
import { getData } from '../v2/data.js';
import { NAVS, scanBar } from '../v2/views.js';
/*
 * nav  — 메뉴에서 밑줄을 그을 칸 (home·jobs·companies·industries·roles·techs·scan)
 * q    — 검색창에 미리 넣어 둘 글자 (/jobs/?q= 로 들어왔을 때)
 */
const { title, description, canonical, schema, noindex, nav = '', q = '' } = Astro.props;
const D = getData();
const site = Astro.site?.href.replace(/\/$/, '') ?? '';
const url = canonical ?? (site + Astro.url.pathname);
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  {/*
    검색에 내보내지 않는 페이지 (2026-11-02 대표님 지시)

    회사가 내린 공고 중 우리 요약이 없는 것들입니다. 페이지는 남깁니다 —
    구글이 색인해 둔 주소로 들어온 사람에게 404 대신 마감 사실을 알리기
    위해서입니다. 다만 새로 색인되지는 않게 막습니다.
    follow 를 붙여 이 페이지의 링크는 따라가게 둡니다.
  */}
  {noindex && <meta name="robots" content="noindex, follow" />}

  {/*
    파비콘.

    선언이 없으면 브라우저와 검색 크롤러가 /favicon.ico 를 알아서 찾습니다.
    그 파일이 없으면 오류가 납니다. 2026-09-13 네이버 사이트 진단에서
    "접근 불가한 페이지 1건" 으로 잡힌 것이 이것이었습니다.

    ico 안에 16~256px 여섯 가지를 담았습니다. 브라우저 탭은 작은 것을,
    바탕화면 바로가기는 큰 것을 씁니다.
  */}
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  {/*
    홈 화면에 앱처럼 추가할 수 있게 하는 설정(PWA).
    서비스 워커는 알림 전용(/sw.js)만 둡니다. 공고는 마감·삭제가 잦아서
    페이지를 저장(캐시)하는 서비스 워커는 일부러 두지 않습니다.
    폰에 옛 화면이 저장되면 마감된 공고에 지원하는 일이 생깁니다.
  */}
  <link rel="manifest" href="/manifest.webmanifest" />
  {/*
    RSS 피드. 네이버가 사이트맵보다 이 주소를 더 자주 확인해 "새 글이
    올라왔다" 는 신호로 씁니다. src/pages/rss.xml.js 가 만듭니다. (2026-11-03)
  */}
  <link rel="alternate" type="application/rss+xml" title="서치잡 — 자동차부품·전자 채용공고" href="/rss.xml" />
  <meta name="theme-color" content="#2D5F7C" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:locale" content="ko_KR" />
  <meta property="og:site_name" content="SEARCHJOB" />

  {/*
    공유 썸네일.

    네이버는 검색 결과와 블로그 공유에 이 그림을 씁니다. 없으면 글자만
    나가서 눈에 덜 띕니다. 카카오톡·슬랙도 같은 값을 읽습니다.

    주소는 반드시 https 로 시작하는 전체 주소여야 합니다. /og.png 처럼
    적으면 네이버와 카카오가 찾지 못합니다.

    1200x630 은 오픈그래프 권장 크기입니다. 이보다 작으면 흐리게 보이고,
    비율이 다르면 잘립니다.
  */}
  <meta property="og:image" content={`${site}/og.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="SEARCHJOB 기업 공식 채용페이지 통합 검색" />

  {/* 트위터·슬랙 등은 이 이름으로 읽습니다. 같은 그림을 씁니다. */}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${site}/og.png`} />

  <!-- 검색엔진 소유확인. 발급받은 값으로 교체하세요. -->
  <meta name="naver-site-verification" content="51b697d739abb1527383ad0c0eab3c9c876f4cf4" />
  <meta name="google-site-verification" content="LFo_U8G6jYtvHtMnup5pQmSudsK1sqmXN6qnXlo_aw4" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  {/*
    방문 통계 (구글 애널리틱스 4). 2026-10-27 추가.

    측정 ID 출처: 구글 애널리틱스 계정 "서치잡"(413542968) → 속성 "서치잡 웹사이트"
    → 웹 스트림 "서치잡"(https://searchjob.co.kr, 스트림 ID 16210085678).
    서치넷(searchnet.co.kr)·다정리와는 계정이 따로입니다. 데이터 공유 설정은 모두 끔.

    아래 클라우드플레어 웹 애널리틱스(쿠키 없음)는 그대로 둡니다. 구글 쪽은
    유입 경로·검색어·많이 본 기업 페이지처럼 더 자세한 것을 보려고 더했습니다.
    구글 애널리틱스는 쿠키를 쓰므로 꼬리말에 한 줄로 알립니다.
    끄려면 이 블록 두 개의 script 를 지우고 꼬리말 문장도 지우세요.
  */}
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-DGZ73M54LE"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-DGZ73M54LE');
  </script>

  {/*
    구조화 데이터.

    JSON.stringify 를 그냥 쓰면 안 됩니다. 본문 안에 </script> 가 있는
    공고에서 이 블록이 중간에 끊겨, 구글이 "파싱할 수 없는 구조화된
    데이터 · 잘못된 값 유형" 으로 보고했습니다(2026-10-16).
    ldJson 이 "<" ">" "&" 를 JSON 유니코드 표기로 바꿔 넣습니다.
    내용은 완전히 같고 끊기지만 않습니다. lib.js 의 ldJson 주석 참고.
  */}
  {schema && <script type="application/ld+json" set:html={ldJson(schema)} />}

{/*
    머리줄 (2026-11-03 대표님 확정)
    11-02 확정본의 검정 머리줄을 걷어내고 빨간 워드마크를 올렸습니다.
    로고 · 검색창 / 메뉴 / 점검 상태, 세 줄이 모든 쪽에 똑같이 붙습니다.
    스타일은 global.css 의 .top · .gnav · .scanbar 입니다.
  */}
</head>
<body>
  <header class="top">
    <div class="wrap">
      <a class="brand" href="/" aria-label="SEARCHJOB 홈"><b>SEARCHJOB</b><small>기업 공식 채용페이지 통합 검색</small></a>
      <div class="search">
        {/* 검색은 공고 목록(/jobs/)이 받습니다. 그 쪽에서는 치는 대로 걸러지고,
            다른 쪽에서는 Enter 로 넘어갑니다. 기업 목록에서는 기업을 거릅니다. */}
        <form action="/jobs/" method="get" role="search">
          <input id="q" name="q" type="search" placeholder="직무 · 기업 · 기술로 찾기" autocomplete="off" value={q} aria-label="공고 검색" />
        </form>
      </div>
      {/* 로그인 (2026-11-05). 로그인한 브라우저에서는 /member.js 가 「마이페이지」로 바꿉니다. */}
      <a id="login-link" class="login-link" href="/my/">로그인</a>
    </div>
    <nav class="gnav" aria-label="사이트 메뉴"><div class="wrap">
      {NAVS.map(([k, label, href]) => (
        <a href={href} aria-current={nav === k ? 'page' : undefined}>{label}</a>
      ))}
      <a href="/my/" id="gnav-my" class="gnav-my" aria-current={nav === 'my' ? 'page' : undefined}>내 공간</a>
    </div></nav>
  </header>
  <div class="scanbar"><div class="wrap" set:html={scanBar(D)} /></div>
  <slot />
  <footer class="wrap">
    {/* 모든 페이지에서 소개로 갈 수 있게 둡니다. 홈 제목 영역에도
        한 줄 소개와 함께 같은 링크가 있습니다. (2026-10-16) */}
    <p style="margin-bottom:10px"><a href="/about/" class="back">SEARCHJOB 소개</a> · <a href="/app/" class="back">홈 화면에 설치</a> · <a href="/terms/" class="back">이용약관</a> · <a href="/privacy/" class="back">개인정보처리방침</a></p>
    <p>각 기업 공식 채용페이지에 공개된 공고만 모았습니다. 채용 플랫폼 전용 공고나 비공개 채용은 포함되지 않습니다.</p>
    <p style="margin-top:8px"><b>여러 직무 포함 가능</b> 표시는 공고 본문이 이미지로 게시되어 세부 직무를 원문에서 확인해야 하는 경우입니다.</p>
    <p style="margin-top:8px">방문 통계를 위해 구글 애널리틱스(쿠키 사용)와 클라우드플레어 웹 애널리틱스를 씁니다. 로그인은 선택입니다. 로그인하면 카카오·네이버·구글이 알려 주는 회원번호와 별명만 받고, 이메일·전화번호·실명은 받지 않습니다.</p>
    {/* 문의처 (2026-11-03 대표님 지시). 모든 페이지 꼬리말에 들어갑니다. */}
    <p style="margin-top:8px"><b>문의처 : <a href="mailto:searchjob.kr@gmail.com">searchjob.kr@gmail.com</a></b></p>
  </footer>

  <!-- Cloudflare Web Analytics. 쿠키를 쓰지 않아 동의 배너가 필요 없습니다.
       봇은 자바스크립트를 실행하지 않으므로 실제 방문자만 집계됩니다.

       토큰은 Cloudflare 대시보드 → Web Analytics → searchjob.co.kr →
       Manage site 의 "Install JS Snippet" 에 있는 값과 한 글자도 다르면 안 됩니다.
       2026-11-01 까지 여기 다른 토큰(449e0886...)이 들어 있어서, 설치한 지
       24일이 지나도록 집계가 0건이었습니다. 대시보드에 "데이터가 충분하지
       않습니다" 만 떴습니다. 같은 기간 구글 애널리틱스는 정상이었으니
       사이트 문제가 아니라 토큰 문제였습니다.
       토큰을 바꿀 일이 있으면 배포 뒤 하루쯤 지나 대시보드에 숫자가
       올라오는지 반드시 확인하세요. -->
  <script is:inline>
    /* 「N건 더 보기」 — 서버가 다 그려 두고 숨긴 카드를 60건씩 엽니다.
       (산업·직무·기술·기업 쪽. 검색엔진은 숨긴 카드까지 다 읽습니다.) */
    document.addEventListener('click', function (e) {
      var b = e.target.closest('button[data-reveal]');
      if (!b) return;
      var box = b.previousElementSibling;
      var hid = box ? box.querySelectorAll(':scope > [hidden]') : [];
      var n = Number(b.getAttribute('data-reveal')) || 60;
      for (var i = 0; i < hid.length && i < n; i += 1) hid[i].hidden = false;
      var left = hid.length - Math.min(n, hid.length);
      if (left > 0) b.textContent = left.toLocaleString('ko-KR') + '건 더 보기';
      else b.remove();
    });
  </script>
  {/* 폰 아래 고정 메뉴(앱처럼). 넓은 화면에서는 CSS 로 숨깁니다. 「내 공간」은 로그인 전에는 로그인 화면으로 갑니다. */}
  <nav class="tabbar" aria-label="하단 메뉴">
    <a href="/" aria-current={nav === 'home' ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11l9-8 9 8v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg><span>홈</span></a>
    <a href="/jobs/" aria-current={nav === 'jobs' ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l5 5"/></svg><span>공고</span></a>
    <a href="/companies/" aria-current={nav === 'companies' ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 21V5a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v16M14 10h5a1 1 0 0 1 1 1v10M8 8h2M8 12h2M8 16h2M4 21h16"/></svg><span>기업</span></a>
    <a href="/my/" id="tab-my" aria-current={nav === 'my' ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg><span id="tab-my-label">로그인</span></a>
  </nav>
  <script is:inline defer src="/member.js"></script>
  <script type="module" defer src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon='{"token": "4da0c82f0e654b77806a517d1b4f94ad"}'></script>
</body>
</html>
