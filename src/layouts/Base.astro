---
import '../styles/global.css';
const { title, description, canonical, schema } = Astro.props;
const site = Astro.site?.href.replace(/\/$/, '') ?? '';
const url = canonical ?? (site + Astro.url.pathname);
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:locale" content="ko_KR" />
  <meta property="og:site_name" content="SEARCHJOB" />

  {/*
    공유 썸네일.

    네이버는 검색 결과와 블로그 공유에 이 그림을 씁니다. 없으면 글자만
    나가서 눈에 덜 띕니다. 카카오톡·슬랙도 같은 값을 읽습니다.

    주소는 반드시 https 로 시작하는 전체 주소여야 합니다. /og.png 처럼
    적으면 네이버와 카카오가 찾지 못합니다.

    1200x630 은 오픈그래프 권장 크기입니다. 이보다 작으면 흐리게 보이고,
    비율이 다르면 잘립니다.
  */}
  <meta property="og:image" content={`${site}/og.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="SEARCHJOB 기업 공식 채용페이지 통합 검색" />

  {/* 트위터·슬랙 등은 이 이름으로 읽습니다. 같은 그림을 씁니다. */}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${site}/og.png`} />

  <!-- 검색엔진 소유확인. 발급받은 값으로 교체하세요. -->
  <meta name="naver-site-verification" content="51b697d739abb1527383ad0c0eab3c9c876f4cf4" />
  <meta name="google-site-verification" content="LFo_U8G6jYtvHtMnup5pQmSudsK1sqmXN6qnXlo_aw4" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

<style is:global>
  /* 사이트 공통 헤더. 사양서 감각에 맞춰 Plex Mono 로 자간을 넓힌 워드마크입니다. */
  header.site {
    border-bottom: 1px solid var(--line, #DDE1DE);
    background: var(--paper, #fff);
  }
  /*
   * 넓은 화면에서는 워드마크 줄을 붙여둡니다. 검색창·탭과 함께
   * 세 줄이 고정되어 스크롤 중에도 조작할 수 있습니다.
   *
   * 좁은 화면에서는 붙이지 않습니다. 세로 700px 중 고정 영역이
   * 166px 이면 공고 볼 자리가 그만큼 줄어듭니다. 모바일에서 사이트
   * 이름이 계속 보일 이유는 약합니다.
   */
  @media (min-width: 861px) {
    header.site { position: sticky; top: 0; z-index: 40; }
  }
  header.site .wrap {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding-top: 18px;
    padding-bottom: 18px;
  }
  /*
   * 워드마크는 사이트 이름입니다. 17px 은 본문(16px)과 거의 같아서
   * 이름이 아니라 작은 라벨로 읽혔습니다. 24px 로 키우고 설명은
   * 그만큼 물러나게 해 위계를 만듭니다.
   */
  .wordmark {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-weight: 600;
    font-size: 24px;
    letter-spacing: .12em;
    color: var(--ink, #16181C);
    text-decoration: none;
    white-space: nowrap;
  }
  .wordmark:hover { color: var(--steel, #2D5F7C); }
  .wm-tag { font-size: 13px; color: #858B92; letter-spacing: -.01em; }
  @media (max-width: 520px) {
    header.site .wrap {
      flex-direction: column; gap: 3px; align-items: flex-start;
      padding-top: 14px; padding-bottom: 14px;
    }
    .wordmark { font-size: 21px; }
    .wm-tag { font-size: 12px; }
  }
</style>
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a class="wordmark" href="/" aria-label="SEARCHJOB 홈">SEARCHJOB</a>
      <span class="wm-tag">기업 공식 채용페이지 통합 검색</span>
    </div>
  </header>
  <slot />
  <footer class="wrap">
    <p>각 기업 공식 채용페이지에 공개된 공고만 모았습니다. 채용 플랫폼 전용 공고나 비공개 채용은 포함되지 않습니다.</p>
    <p style="margin-top:8px"><b>여러 직무 포함 가능</b> 표시는 공고 본문이 이미지로 게시되어 세부 직무를 원문에서 확인해야 하는 경우입니다.</p>
  </footer>

  <!-- Cloudflare Web Analytics. 쿠키를 쓰지 않아 동의 배너가 필요 없습니다.
       봇은 자바스크립트를 실행하지 않으므로 실제 방문자만 집계됩니다. -->
  <script type="module" defer src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon='{"token": "449e08863244437ea9cd0e8010c51546"}'></script>
</body>
</html>
