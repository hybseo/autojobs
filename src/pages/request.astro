---
/*
 * 기업 채용담당자의 채용페이지 등록 요청 (2026-11-13 대표님 지시)
 * =====================================================================
 * 대상은 기업 채용담당자입니다. 구직자 요청은 받지 않기로 했습니다(채용페이지가
 * 없거나 막혀 있어 추가할 수 없는 경우가 많고, 담당자는 필요한 것을 바로 줄 수 있음).
 *
 * 보내면 worker/index.js 의 /api/company-request 가 D1 company_requests 표에 저장하고,
 * 매일 아침 회원 통계 보고에 「기업 등록 요청」으로 회사명·주소가 함께 나갑니다.
 * 이메일·이름은 보고에 넣지 않습니다(회신할 때 D1 콘솔에서 확인).
 *
 * 받는 항목을 바꾸면 개인정보처리방침(src/pages/privacy.astro 1·2·3번)도 같이 고치세요.
 */
import Base from '../layouts/Base.astro';
import { companyPages } from '../lib.js';

const title = '채용페이지 등록 요청 (기업 채용담당자) | SEARCHJOB';
const desc = '자사 공식 채용페이지의 공고를 서치잡에 노출하고 싶은 기업 채용담당자는 채용페이지 주소를 알려 주세요. 확인 후 등록하고 결과를 이메일로 알려 드립니다.';
// 이미 수집 중인 기업이면 바로 알려 주려고 이름 목록을 싣습니다(이름·주소만).
const known = companyPages().map((c) => ({ n: c.name, s: c.slug }));
---
<Base title={title} description={desc}>
  <main class="wrap" style="max-width:720px">
    <section class="doc">
      <h1 style="margin:24px 0 8px">채용페이지 등록 요청</h1>
      <p class="sub">기업 채용담당자를 위한 페이지입니다.</p>
      <p style="margin-top:14px">
        서치잡은 기업이 자사 공식 채용페이지에 직접 올린 공고만 모읍니다. 귀사의 채용페이지 주소를 알려 주시면
        공고를 읽어 올 수 있는지 확인한 뒤 등록하고, 결과를 이메일로 알려 드립니다. 등록과 노출은 무료입니다.
      </p>
      <ul style="margin:12px 0 0 18px;line-height:1.7">
        <li>채용 플랫폼(사람인·잡코리아 등)에만 올린 공고는 모으지 않습니다. 자사 채용페이지(그리팅·리크루터·나인하이어 등 채용 시스템으로 만든 페이지 포함)가 있어야 합니다.</li>
        <li>채용페이지가 자동 접근을 막고 있거나 공고가 이미지 한 장뿐이면 등록이 어렵거나 원문 링크만 제공될 수 있습니다.</li>
      </ul>

      <form id="req" style="margin-top:22px;display:grid;gap:14px" novalidate>
        <label>회사명 <b style="color:var(--urgent)">*</b>
          <input name="company" required maxlength="80" autocomplete="organization" style="width:100%;padding:10px;border:1px solid var(--line);border-radius:8px;margin-top:4px" />
        </label>
        <p id="known" class="sub" style="display:none;margin:-6px 0 0"></p>
        <label>채용페이지 주소 <b style="color:var(--urgent)">*</b>
          <input name="url" required maxlength="300" placeholder="https://" inputmode="url" style="width:100%;padding:10px;border:1px solid var(--line);border-radius:8px;margin-top:4px" />
        </label>
        <label>회신받을 이메일 <b style="color:var(--urgent)">*</b>
          <input name="email" type="email" required maxlength="120" autocomplete="email" style="width:100%;padding:10px;border:1px solid var(--line);border-radius:8px;margin-top:4px" />
        </label>
        <label>담당자 이름·부서 (선택)
          <input name="name" maxlength="40" autocomplete="name" style="width:100%;padding:10px;border:1px solid var(--line);border-radius:8px;margin-top:4px" />
        </label>
        <label>전하실 말 (선택)
          <textarea name="message" maxlength="1000" rows="4" style="width:100%;padding:10px;border:1px solid var(--line);border-radius:8px;margin-top:4px"></textarea>
        </label>
        {/* 사람은 보지 못하는 칸. 자동 입력 프로그램이 채우면 서버가 버립니다. */}
        <div aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden">
          <label>website <input name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <label style="display:flex;gap:8px;align-items:flex-start;font-size:14px">
          <input type="checkbox" name="agree" style="margin-top:3px" />
          <span>개인정보 수집·이용에 동의합니다. (항목: 이메일, 이름·부서(선택) · 목적: 등록 결과 회신 · 보관: 접수 후 1년, 이후 삭제 ·
          <a href="/privacy/">개인정보처리방침</a>) 동의하지 않으면 요청을 보낼 수 없습니다.</span>
        </label>
        <button type="submit" style="padding:12px;border:0;border-radius:10px;background:var(--ink);color:var(--paper);font-weight:700;cursor:pointer">요청 보내기</button>
        <p id="msg" role="status" style="min-height:1.4em;margin:0"></p>
      </form>
      <p class="sub" style="margin-top:18px">이메일로 보내셔도 됩니다: <a href="mailto:searchjob.kr@gmail.com">searchjob.kr@gmail.com</a></p>
    </section>
  </main>
  <script is:inline define:vars={{ known }}>
    (function () {
      var f = document.getElementById('req');
      var msg = document.getElementById('msg');
      var kn = document.getElementById('known');
      var norm = function (s) { return String(s || '').toLowerCase().replace(/\(주\)|㈜|주식회사|\s|\.|,/g, ''); };
      f.company.addEventListener('input', function () {
        var q = norm(f.company.value);
        var hit = q.length >= 2 ? known.find(function (c) { return norm(c.n) === q; }) : null;
        if (hit) {
          kn.style.display = 'block';
          kn.innerHTML = '이미 수집 중인 기업입니다. <a href="/company/' + encodeURIComponent(hit.s) + '/">' + hit.n.replace(/[<>&"]/g, '') + ' 공고 보기</a> — 공고가 빠졌거나 주소가 바뀌었다면 아래에 적어 보내 주세요.';
        } else { kn.style.display = 'none'; }
      });
      f.addEventListener('submit', function (e) {
        e.preventDefault();
        var d = {
          company: f.company.value.trim(), url: f.url.value.trim(), email: f.email.value.trim(),
          name: f.name.value.trim(), message: f.message.value.trim(), website: f.website.value,
          agree: f.agree.checked,
        };
        if (!d.company || !d.url || !d.email) { msg.textContent = '회사명, 채용페이지 주소, 이메일을 적어 주세요.'; return; }
        if (!/^https?:\/\//i.test(d.url)) d.url = 'https://' + d.url;
        if (!d.agree) { msg.textContent = '개인정보 수집·이용에 동의해 주세요.'; return; }
        var btn = f.querySelector('button[type=submit]');
        btn.disabled = true; msg.textContent = '보내는 중…';
        fetch('/api/company-request', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(d) })
          .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
          .then(function (x) {
            if (x.ok) {
              f.reset(); kn.style.display = 'none';
              msg.textContent = '요청을 받았습니다. 채용페이지를 확인한 뒤 결과를 이메일로 알려 드리겠습니다.';
              if (window.gtag) window.gtag('event', 'company_request', { transport_type: 'beacon' });
            } else { msg.textContent = (x.j && x.j.error) || '보내지 못했습니다. 잠시 뒤 다시 시도해 주세요.'; }
          })
          .catch(function () { msg.textContent = '보내지 못했습니다. 잠시 뒤 다시 시도하시거나 이메일로 보내 주세요.'; })
          .finally(function () { btn.disabled = false; });
      });
    })();
  </script>
</Base>
