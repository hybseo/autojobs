---
/*
 * 네이버 검색로봇이 읽을 수 있는 페이지 크기의 한계를 찾는 시험용 페이지입니다.
 * ---------------------------------------------------------------------------
 * 2026-10-14 에 만들었습니다. 한계를 찾으면 지웁니다.
 *
 * 왜 필요한가
 * -----------
 * 네이버 서치어드바이저의 URL 검사에서 이렇게 갈렸습니다.
 *
 *     홈 (5,039KB)        접근할 수 없습니다
 *     홈 (3,765KB)        접근할 수 없습니다
 *     산업 (2,584KB)      정상
 *     직무 (700KB)        정상
 *     기업 (8KB)          정상
 *
 * 한계가 2,584KB 와 3,765KB 사이 어딘가입니다. 그런데 홈을 더 줄이려면
 * 검색·필터 코드를 뜯어고쳐야 하고, 그러고도 통과할지는 모릅니다.
 * 한계가 2,600KB 였다면 그 작업이 통째로 헛수고가 됩니다.
 *
 * 그래서 크기만 다른 페이지를 만들어 먼저 물어봅니다. 홈은 건드리지
 * 않으니 사이트가 깨질 일도 없습니다.
 *
 * 쓰는 법
 * -------
 * 네이버 서치어드바이저 → 검증 → URL 검사에 아래 주소를 하나씩 넣습니다.
 *
 *     https://searchjob.co.kr/sizetest/2700/
 *     https://searchjob.co.kr/sizetest/3000/
 *     https://searchjob.co.kr/sizetest/3400/
 *
 * 숫자는 목표 KB 입니다. 통과하는 가장 큰 값과 실패하는 가장 작은 값
 * 사이가 한계입니다.
 *
 * 검색엔진에 대한 배려
 * --------------------
 * 사이트맵에 넣지 않고 어디서도 링크하지 않습니다. noindex 는 일부러
 * 걸지 않았습니다. noindex 가 있으면 URL 검사 결과가 "수집 가능하나
 * 노출 불가" 로 나와, 우리가 알고 싶은 "읽을 수 있는가" 가 가려집니다.
 *
 * 한계를 확인하면 이 파일을 지웁니다. 지우면 주소는 404 가 됩니다.
 * 어차피 아무도 모르는 주소라 리디렉션은 두지 않습니다.
 */
import Base from '../../layouts/Base.astro';
import JobCard from '../../components/JobCard.astro';
import { openJobs, byDeadline } from '../../lib.js';

// 카드 한 장이 약 725 바이트, 카드 아닌 틀이 약 108KB 였습니다(2026-10-14 실측).
// 목표 KB 에서 틀을 빼고 카드 수를 역산합니다. 빌드 뒤 실제 크기를 재서
// 맞는지 확인하세요. 정확히 맞출 필요는 없고 근처면 됩니다.
const BYTES_PER_CARD = 725;
const FRAME_KB = 20;   // 이 시험 페이지는 홈보다 틀이 가볍습니다(필터·탭 없음)

export function getStaticPaths() {
  return [2700, 3000, 3400].map((n) => ({ params: { n: String(n) } }));
}

const target = Number(Astro.params.n);
const count = Math.max(0, Math.round(((target - 20) * 1024) / 725));
const jobs = openJobs().sort(byDeadline).slice(0, count);
---

<Base title={`크기 시험 ${target}KB`} description={`네이버 수집 한계를 찾는 시험용 페이지입니다. 공고 ${jobs.length}건.`}>
  <main class="wrap">
    <h1>크기 시험 {target}KB</h1>
    <p>공고 {jobs.length}건을 담았습니다. 네이버 검색로봇이 이 크기를 읽을 수 있는지 확인하려고 만든 임시 페이지입니다.</p>
    <div class="list">
      {jobs.map((job) => <JobCard job={job} />)}
    </div>
  </main>
</Base>
