---
import Base from '../layouts/Base.astro';
import JobCard from '../components/JobCard.astro';
import { openJobs, byDeadline, isAlways, COLLECTED_AT, STALE_DAYS, companies, industries, industriesOf } from '../lib.js';

// 마감 있는 공고가 먼저, 상시채용이 뒤로 옵니다.
const jobs = openJobs().sort(byDeadline);
const cos = companies().length;
const alwaysN = jobs.filter(isAlways).length;
const deadlineN = jobs.length - alwaysN;
const tally = (f) => {
  const m = new Map();
  jobs.forEach((j) => m.set(f(j), (m.get(f(j)) || 0) + 1));
  return [...m.entries()].sort((a, b) => b[1] - a[1]);
};
// 검색 노출은 키워드가 좌우합니다. 브랜드만 남기면 신규 도메인은 잡힐 근거가 없습니다.
// 두 번째 산업이 실제로 들어오면 그때 넓히세요.
// 산업을 넣지 않습니다. 자동차부품 외에 로봇·반도체가 들어왔고 앞으로 더 늘어납니다.
// 늘 때마다 제목을 고치면 그때마다 다시 크롤링돼야 반영됩니다.
// 산업 키워드는 /industry/{slug}/ 페이지가 각각 받아냅니다.
const title = '기업 공식 채용공고 통합 검색 | SEARCHJOB';
// 검색 결과에 뜨는 설명문입니다.
//
// 숫자를 넣지 않습니다. 매일 바뀌는데 검색엔진은 크롤링 시점 값을 캐시해서,
// 며칠 지난 숫자가 그대로 노출됩니다. 실제로 구글 결과에 "15곳 58건" 이
// 한참 남아 있었습니다.
//
// 산업도 넣지 않습니다. 자동차부품 외에 반도체·로봇이 들어왔고 앞으로 더
// 늘어납니다. 산업 키워드는 /industry/{slug}/ 페이지가 각각 받아냅니다.
const desc = '기업 공식 채용페이지에 올라온 공고를 한곳에 모았습니다. 흩어진 채용정보를 한눈에 검색하고 원문으로 바로 이동하세요.';
---
<Base title={title} description={desc}>
  <header class="mast">
    <div class="wrap">
      <h1>지금 지원할 수 있는 자리 <em>{jobs.length}</em></h1>
      <div class="meta">
        <b>{cos}</b>개사 공식 채용페이지 · <b>{COLLECTED_AT.replace(/-/g, '.')}</b> 기준
        {STALE_DAYS >= 1 && (
          <span class="stale">{STALE_DAYS}일 전 정보 · 마감된 공고가 있을 수 있습니다</span>
        )}
      </div>
    </div>
  </header>

  <div class="split">
  <div class="controls">
    <div class="wrap ctrl-in">
      <div class="searchrow">
        <input id="q" type="search" placeholder="직무, 기업, 근무지 검색" autocomplete="off" />
        <button class="sortbtn" id="sort" type="button">마감 임박순</button>
      </div>
      {industries().length > 1 && (
        <div class="chips ind" id="fIn">
          {industries().map((i) => (
            <button class="chip" type="button" data-k="in" data-v={i.name} aria-pressed="false">{i.name}<span class="n">{i.jobs.length}</span></button>
          ))}
          <button class="chip morebtn" id="moreIn" type="button" hidden></button>
        </div>
      )}
      <div class="chips" id="fCo">
        {tally((j) => j.company).map(([v, n]) => (
          <button class="chip" type="button" data-k="co" data-v={v} aria-pressed="false">{v}<span class="n">{n}</span></button>
        ))}
        <button class="chip morebtn" id="moreCo" type="button" hidden></button>
      </div>
      <div class="chips" id="fCa">
        {tally((j) => j.career).map(([v, n]) => (
          <button class="chip" type="button" data-k="ca" data-v={v} aria-pressed="false">{v}<span class="n">{n}</span></button>
        ))}
        <button class="chip morebtn" id="moreCa" type="button" hidden></button>
      </div>
    </div>
  </div>

  <main class="wrap">
    {alwaysN > 0 && deadlineN > 0 && (
      <div class="tabs" role="tablist" aria-label="접수 방식">
        <button class="tab" role="tab" data-tab="마감 있음" aria-selected="true">
          마감 있는 공고 <span class="tn">{deadlineN}</span>
        </button>
        <button class="tab" role="tab" data-tab="상시채용" aria-selected="false">
          상시채용 <span class="tn">{alwaysN}</span>
        </button>
      </div>
    )}
    <div class="count" id="count"><b>{deadlineN}</b>건 표시 중</div>
    <div class="list" id="list">
      {jobs.map((j) => <JobCard job={j} />)}
      <div class="empty" id="empty" hidden>
        <b>조건에 맞는 자리가 없습니다</b>
        검색어를 줄이거나 필터를 해제해 보세요.
        <button class="othertab" id="otherTab" type="button" hidden></button>
      </div>
    </div>

    {industries().length > 1 && (
      <>
        <div class="section-h">산업별로 보기</div>
        <ul class="archive">
          {industries().map((i) => (
            <li><a href={`/industry/${i.slug}/`}>{i.name} 채용</a><time>{i.jobs.length}건</time></li>
          ))}
        </ul>
      </>
    )}

    <div class="section-h">기업별로 보기</div>
    <ul class="archive">
      {companies().map((c) => (
        <li><a href={`/company/${c.slug}/`}>{c.name} 채용</a><time>{c.jobs.length}건</time></li>
      ))}
    </ul>
  </main>
  </div>
</Base>

<style is:global>
  /* ═══════════════════════════════════════════════════
   * 새 배색 + 넓은 화면 2단
   *
   * 모바일은 지금 구조(칩 + 카드)가 이미 잘 맞습니다. 191px 이면
   * 공고가 나오고, 카드가 좁은 화면에서 읽기 편합니다.
   * PC 레이아웃을 억지로 접으려 했던 것이 잘못이었습니다.
   *
   * 그래서 구조는 화면 크기로 가릅니다.
   *   861px 이상  필터를 왼쪽에 고정한 2단
   *   860px 이하  지금 그대로 (칩 + 카드)
   * 색과 타이포는 양쪽에 똑같이 입힙니다. 같은 사이트니까요.
   * ═══════════════════════════════════════════════════ */

  /* ── 산업 색 ────────────────────────────────────
   * 부품 카탈로그의 분류 색인에서 가져왔습니다. 장식이 아니라
   * 1,200건을 훑을 때 눈이 잡는 표지입니다.
   * IT 는 게임·의료·보안이 섞여 성격이 넓어 회청색으로 눌렀습니다.
   */
  :global(:root) {
    --auto: #2D5F7C;
    --semi: #6B4E8F;
    --elec: #B5651D;
    --robo: #2F7A5C;
    --it:   #4A5A6B;
    --field: #F4F6F5;
  }
  /* 주 산업(data-ind) 하나로만 칠합니다. data-in 은 여러 산업이 들어가
     여러 선택자가 걸리고, 나중 선언이 이겨 엉뚱한 색이 붙습니다. */
  :global(.card[data-ind="자동차부품"]) { --c: var(--auto); }
  :global(.card[data-ind="반도체"])     { --c: var(--semi); }
  :global(.card[data-ind="전기전자"])   { --c: var(--elec); }
  :global(.card[data-ind="로봇"])       { --c: var(--robo); }
  :global(.card[data-ind="IT"])         { --c: var(--it); }

  /* 카드 왼쪽에 산업 색 띠. 지금 구조를 건드리지 않고 얹습니다. */
  :global(.list .card) {
    position: relative;
    border-left: 4px solid var(--c, #D5DAD6) !important;
  }

  /* ── 검색줄 대비 ────────────────────────────────
   * 흰 바탕에 흰 입력창이라 묻혔습니다.
   */
  .searchrow :global(#q) { border-color: #C9D0CB; background: #fff; }
  .controls { border-bottom: 1px solid #C9D0CB; }

  /* ── 마감 임박 ─────────────────────────────────
   * 색이 정보를 나르도록. 지금은 회색 계열이라 눈에 안 띕니다.
   */
  :global(.dday.d-urgent) { color: #B3261E; font-weight: 600; }
  :global(.dday.d-warn)   { color: #8A5A20; }

  /* ── 넓은 화면: 필터를 왼쪽에 고정 ────────────── */
  @media (min-width: 861px) {
    .split {
      max-width: 1180px; margin: 0 auto;
      display: grid; grid-template-columns: 236px 1fr; align-items: start;
    }
    /* 필터가 면으로 물러나고 목록이 앞으로 나옵니다. */
    .controls {
      position: sticky; top: 0; align-self: start;
      background: var(--field);
      border-right: 1px solid #DDE1DE; border-bottom: 0;
      min-height: 100vh; padding: 18px 0 40px;
    }
    .controls :global(.ctrl-in) { padding: 0 16px; max-width: none; }
    .searchrow { flex-direction: column; align-items: stretch; gap: 8px; }
    .searchrow :global(.sortbtn) { width: 100%; }

    /* 칩을 세로 목록으로. 기업이 126개라 가로 나열은 한계입니다. */
    .controls :global(.chips) {
      display: block; margin-top: 14px;
      max-height: 240px; overflow-y: auto;
    }
    .controls :global(.chip) {
      display: flex; width: 100%; justify-content: space-between;
      border: 0; border-radius: 3px; background: none; padding: 5px 8px;
      margin: 0; font-size: 13.5px;
    }
    .controls :global(.chip:hover) { background: #E8ECE9; }
    .controls :global(.chip[aria-pressed='true']) {
      background: #16181C; color: #fff;
    }
    .controls :global(.morebtn) { display: none !important; }

    main.wrap { background: #fff; padding: 0 22px; max-width: none; min-height: 100vh; }
  }

  /*
   * 카드 숨김.
   * hidden 속성만으로는 안 됩니다. global.css 의 .card 규칙이 클래스 선택자라
   * 브라우저 기본값인 [hidden]{display:none} 을 우선순위에서 이깁니다.
   * 그래서 필터를 걸어도 카드가 그대로 보였습니다. !important 로 못박습니다.
   */
  .list .card[hidden] { display: none !important; }

  /* 목록 중간 구획선. 기존 .section-h 를 쓰되 여백만 조정합니다. */
  .grp { margin-top: 2rem; }
  .grp .gn { font-variant-numeric: tabular-nums; }

  /*
   * 접수 방식 필터는 성격이 다릅니다.
   * 기업·경력은 "무엇을" 고르는 것이고, 이건 "언제까지"를 고르는 것이라
   * 시그니처 색인 스틸블루로 구분합니다.
   */
  /*
   * 접수 방식 탭.
   * 상시채용이 목록의 3분의 2를 차지하면서 한 목록에 담을 수 없게 됐습니다.
   * 아래에 쌓아두면 사실상 안 보이므로 탭으로 나눕니다.
   * 시그니처 색인 스틸블루로 선택 상태를 표시합니다.
   */
  .tabs {
    display: flex;
    gap: 4px;
    border-bottom: 1px solid var(--line, #DDE1DE);
    margin-bottom: 4px;
  }
  .tabs .tab {
    appearance: none;
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    padding: 10px 14px;
    font: inherit;
    font-size: 14px;
    color: #858B92;
    cursor: pointer;
    white-space: nowrap;
  }
  .tabs .tab:hover { color: var(--ink, #16181C); }
  .tabs .tab[aria-selected='true'] {
    color: var(--steel, #2D5F7C);
    border-bottom-color: var(--steel, #2D5F7C);
    font-weight: 600;
  }
  .tabs .tn {
    margin-left: 5px;
    font-variant-numeric: tabular-nums;
    font-size: 12px;
    opacity: .75;
  }
  @media (max-width: 400px) {
    .tabs .tab { padding: 10px 8px; font-size: 13px; }
  }

  .othertab {
    display: block;
    margin: 10px auto 0;
    padding: 7px 14px;
    border: 1px solid var(--steel, #2D5F7C);
    border-radius: 999px;
    background: none;
    color: var(--steel, #2D5F7C);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }
  .othertab:hover { background: var(--steel, #2D5F7C); color: #fff; }

  /* 접힌 칩. 카드와 마찬가지로 .chip 규칙이 [hidden] 을 이기므로 못박습니다. */
  .chips .chip[hidden] { display: none !important; }

  /* 더보기 버튼은 필터가 아니라 조작 버튼이라 점선으로 구분합니다. */
  .chips .morebtn {
    border-style: dashed;
    color: #858B92;
    font-variant-numeric: tabular-nums;
  }
  .chips .morebtn:hover { color: var(--ink, #16181C); }
  /* 펼친 동안의 접기 버튼. 칩과 구분되게 테두리를 줍니다. */
  .chips .morebtn.folding {
    border: 1px solid #C9D0CB; border-radius: 999px;
    padding: 4px 11px; background: #fff; color: var(--ink, #16181C);
  }
  /*
   * 버튼이 화면 밖으로 밀려나면 아래에 띄웁니다.
   * 자리는 목록 맨 뒤 그대로고, 보이지 않을 때만 떠오릅니다.
   */
  .chips .morebtn.floating {
    position: fixed; left: 50%; transform: translateX(-50%);
    bottom: 20px; z-index: 40;
    box-shadow: 0 2px 10px rgba(22,24,28,.18);
    padding: 9px 20px;
  }

  /*
   * 산업 칩.
   *
   * 회사·경력 칩과 같은 층위가 아닙니다. 산업은 가장 큰 분류이고 셋뿐입니다.
   * 같은 모양이면 "회사 이름 중 하나" 로 읽혀 지나칩니다.
   * 그래서 위치를 맨 위로 올리고 형태를 사각형으로 바꿉니다.
   *
   * 색은 스틸블루를 쓰지 않습니다. 그건 접수방식 탭이 쓰고 있어
   * 같은 색이면 다시 헷갈립니다. 먹색으로 무게를 줍니다.
   */
  .chips.ind { margin-bottom: 2px; }
  .chips.ind .chip {
    border-radius: 3px;
    border-color: #B9C0C6;
    font-weight: 600;
    letter-spacing: -.01em;
  }
  .chips.ind .chip:hover { border-color: var(--ink, #16181C); }
  .chips.ind .chip[aria-pressed='true'] {
    background: var(--ink, #16181C);
    border-color: var(--ink, #16181C);
    color: #fff;
  }
  .chips.ind .chip[aria-pressed='true'] .n { color: #fff; opacity: .7; }
  .chips.ind .morebtn { font-weight: 400; }

  /*
   * 갱신이 밀렸을 때만 나타납니다.
   * 숨기는 것보다 알리는 편이 낫습니다. 구직자가 마감된 공고를
   * 오늘 것으로 알고 지원하는 쪽이 훨씬 나쁩니다.
   */
  .stale {
    display: inline-block;
    margin-left: 8px;
    padding: 2px 8px;
    border-radius: 999px;
    background: #FBE9E7;
    color: #A03A2B;
    font-size: 11px;
    font-weight: 500;
  }
  @media (max-width: 520px) {
    .stale { display: block; margin: 6px 0 0; }
  }
</style>

<script>
  // 카드는 서버에서 이미 렌더링돼 있습니다. 여기서는 보이기/숨기기만 합니다.
  const cards = [...document.querySelectorAll('#list .card')];
  const state = { q: '', co: new Set(), ca: new Set(), in: new Set(), tab: '마감 있음', sort: 'dday' };
  const list = document.getElementById('list');
  const empty = document.getElementById('empty');
  const count = document.getElementById('count');
  const total = cards.length;

  function apply() {
    const q = state.q.trim().toLowerCase();
    let shown = 0;
    for (const c of cards) {
      const ok =
        (!state.co.size || state.co.has(c.dataset.co)) &&
        (!state.ca.size || state.ca.has(c.dataset.career)) &&
        // 한 공고가 여러 산업에 걸칩니다. 하나라도 고른 산업에 들면 보여줍니다.
        (!state.in.size ||
          (c.dataset.in || '').split('|').some((v) => state.in.has(v))) &&
        c.dataset.op === state.tab &&
        (!q || c.dataset.text.includes(q));
      c.hidden = !ok;
      if (ok) shown++;
    }
    empty.hidden = shown > 0;
    // 전체가 아니라 현재 탭 안의 건수와 견줍니다. 탭을 바꾸면 모수가 달라집니다.
    const inTab = cards.filter((c) => c.dataset.op === state.tab).length;
    count.innerHTML = shown
      ? `<b>${shown}</b>건 표시 중${shown < inTab ? ` · ${state.tab} 전체 ${inTab}건` : ''}`
      : '조건에 맞는 자리 없음';

    // 이 탭에서 0건이어도 반대 탭에는 있을 수 있습니다.
    // 42dot 처럼 상시채용만 하는 회사를 "마감 있는 공고" 탭에서 고르면 빈 화면이 됩니다.
    // 그대로 두면 공고가 없는 줄 알고 떠납니다.
    const other = state.tab === '마감 있음' ? '상시채용' : '마감 있음';
    const inOther = cards.filter((c) => {
      const q2 = state.q.trim().toLowerCase();
      return c.dataset.op === other &&
        (!state.co.size || state.co.has(c.dataset.co)) &&
        (!state.ca.size || state.ca.has(c.dataset.career)) &&
        (!state.in.size ||
          (c.dataset.in || '').split('|').some((v) => state.in.has(v))) &&
        (!q2 || c.dataset.text.includes(q2));
    }).length;
    const hint = document.getElementById('otherTab');
    if (hint) {
      if (!shown && inOther) {
        hint.innerHTML = `이 조건에 맞는 자리가 <b>${other}</b>에 ${inOther}건 있습니다.`;
        hint.hidden = false;
      } else {
        hint.hidden = true;
      }
    }
  }

  function sortCards() {
    // 상시채용은 data-dday 가 모두 같은 값이라 원래 순서(최근 게시순)가 유지됩니다.
    const arr = [...cards].sort((a, b) =>
      state.sort === 'dday'
        ? a.dataset.dday - b.dataset.dday
        : a.dataset.co === b.dataset.co
          ? a.dataset.dday - b.dataset.dday
          : a.dataset.co.localeCompare(b.dataset.co, 'ko'));
    arr.forEach((c) => list.insertBefore(c, empty));
  }

  /**
   * 기업 칩이 한없이 길어지는 것을 막습니다.
   * 고정 개수로 자르면 안 됩니다. 한 줄에 들어가는 개수가 화면 폭마다 다릅니다.
   * 모바일은 2~3개, 데스크톱은 8개가 넘습니다. 그래서 실제로 그려진 위치를 재서
   * 첫 줄에 남는 것만 두고 나머지를 접습니다.
   */
  const foldables = [
    [document.getElementById('fCo'), document.getElementById('moreCo')],
    [document.getElementById('fCa'), document.getElementById('moreCa')],
    [document.getElementById('fIn'), document.getElementById('moreIn')],
  ].filter(([box, btn]) => box && btn);

  function foldOne(box, btn) {
    const chips = [...box.querySelectorAll('.chip:not(.morebtn)')];
    if (!chips.length) return;
    chips.forEach((c) => { c.hidden = false; });
    btn.hidden = true;

    if (box.dataset.expanded === '1') {
      btn.hidden = false;
      btn.textContent = '접기';
      /*
       * 접기 버튼은 목록 맨 뒤가 자연스럽습니다. 펼치기와 같은 자리니까요.
       *
       * 다만 기업 칩이 126개라 펼치면 버튼이 한참 아래로 밀려 화면 밖에
       * 나갑니다. 그래서 자리는 그대로 두고, 화면에서 벗어나 있는 동안만
       * 아래쪽에 띄웁니다. 스크롤해서 버튼이 보이면 다시 제자리로.
       */
      btn.classList.add('folding');
      return;
    }
    btn.classList.remove('folding', 'floating');

    const top = chips[0].offsetTop;
    // 선택된 칩은 접지 않습니다. 접히면 해제할 방법이 없어집니다.
    const foldable = chips.filter((c) => c.getAttribute('aria-pressed') !== 'true');
    let folded = 0;
    for (const c of foldable) {
      if (c.offsetTop > top) { c.hidden = true; folded++; }
    }
    if (!folded) return;

    btn.hidden = false;
    btn.textContent = `+${folded}개 더`;
    // 버튼이 붙으면서 줄이 넘칠 수 있습니다. 넘치면 뒤에서부터 하나씩 더 접습니다.
    const visible = () => foldable.filter((c) => !c.hidden);
    let guard = 0;
    while (btn.offsetTop > top && visible().length && guard++ < 50) {
      visible().pop().hidden = true;
      folded++;
      btn.textContent = `+${folded}개 더`;
    }
  }

  function layoutChips() {
    foldables.forEach(([box, btn]) => foldOne(box, btn));
  }

  foldables.forEach(([box, btn]) => {
    btn.addEventListener('click', () => {
      box.dataset.expanded = box.dataset.expanded === '1' ? '0' : '1';
      layoutChips();
      syncFloat();
    });
  });
  let rt;
  window.addEventListener('resize', () => {
    clearTimeout(rt);
    rt = setTimeout(layoutChips, 150);
  });
  layoutChips();

  /*
   * 펼친 상태에서 접기 버튼이 화면 밖에 있으면 아래에 띄웁니다.
   * 버튼이 보이는 위치까지 스크롤하면 다시 제자리로 돌아갑니다.
   */
  function syncFloat() {
    for (const [box, btn] of foldables) {
      if (box.dataset.expanded !== '1' || btn.hidden) {
        btn.classList.remove('floating');
        continue;
      }
      // floating 중에는 제자리 좌표를 알 수 없으므로 잠시 떼고 잽니다.
      const wasFloating = btn.classList.contains('floating');
      if (wasFloating) btn.classList.remove('floating');
      const r = btn.getBoundingClientRect();
      const off = r.bottom > window.innerHeight - 8;
      btn.classList.toggle('floating', off);
    }
  }
  let st;
  window.addEventListener('scroll', () => {
    clearTimeout(st);
    st = setTimeout(syncFloat, 80);
  }, { passive: true });

  // 탭 전환. 필터·검색어는 그대로 두고 대상만 바꿉니다.
  document.querySelectorAll('.tabs .tab').forEach((t) => {
    t.addEventListener('click', () => {
      state.tab = t.dataset.tab;
      document.querySelectorAll('.tabs .tab').forEach((o) => {
        o.setAttribute('aria-selected', String(o === t));
      });
      // 상시채용은 마감일이 없어 "마감 임박순" 이 뜻을 잃습니다. 최근 게시순으로 둡니다.
      apply();
      layoutChips();
    });
  });

  const hintBtn = document.getElementById('otherTab');
  if (hintBtn) {
    hintBtn.addEventListener('click', () => {
      const other = state.tab === '마감 있음' ? '상시채용' : '마감 있음';
      document.querySelector(`.tabs .tab[data-tab="${other}"]`).click();
    });
  }

  document.querySelectorAll('.chip:not(.morebtn)').forEach((b) => {
    b.addEventListener('click', () => {
      const s = state[b.dataset.k];
      s.has(b.dataset.v) ? s.delete(b.dataset.v) : s.add(b.dataset.v);
      b.setAttribute('aria-pressed', s.has(b.dataset.v));
      apply();
      layoutChips();
    });
  });
  document.getElementById('q').addEventListener('input', (e) => {
    state.q = e.target.value; apply();
  });
  document.getElementById('sort').addEventListener('click', (e) => {
    state.sort = state.sort === 'dday' ? 'co' : 'dday';
    e.target.textContent = state.sort === 'dday' ? '마감 임박순' : '기업별';
    sortCards();
  });
</script>
