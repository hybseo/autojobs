---
import Base from '../layouts/Base.astro';
import { getData } from '../v2/data.js';
import { viewHome } from '../v2/views.js';

/*
 * 첫 화면 (버전2 · 2026-11-03 대표님 확정)
 * ============================================================
 * 위에서부터 마감 그래프 → 숫자 넷 → 점검 기록 띠 → 분야 바로 가기 →
 * 오늘 마감 → 최근 7일 새로 열린 공고 → 3일 안에 마감.
 * 그리는 함수는 src/v2/views.js 의 viewHome 입니다.
 *
 * 공고 전체 목록은 /jobs/ 로 옮겼습니다. 전에는 홈이 카드 4,973장을 한
 * 쪽에 그려 3MB 였고, 네이버 검색로봇이 5MB 짜리 홈을 「접근할 수 없음」
 * 으로 보고한 적이 있습니다. 홈은 이제 가볍습니다.
 *
 * 폰에서는 그래프를 낮추고 숫자를 한 줄로, 분야를 옆으로 넘기는 한 줄로
 * 줄여 첫 화면에 공고가 보이게 했습니다 (global.css 맨 아래 폰 규칙).
 */
const D = getData();

// 검색 노출은 키워드가 좌우합니다. 숫자와 산업은 넣지 않습니다 —
// 매일 바뀌는데 검색엔진은 크롤링 시점 값을 오래 캐시합니다.
const title = '기업 공식 채용공고 통합 검색 | SEARCHJOB';
const desc = '기업 공식 채용페이지에 올라온 공고를 한곳에 모았습니다. 흩어진 채용정보를 한눈에 검색하고 원문으로 바로 이동하세요.';
---
<Base title={title} description={desc} nav="home">
  <main class="wrap">
    {/* 쪽 제목. 화면에는 그래프 제목이 맨 위라 글자로는 숨겨 둡니다.
        화면 읽기 프로그램과 검색엔진이 이 쪽이 무엇인지 알게 합니다. */}
    <h1 class="sr-only">기업 공식 채용공고 통합 검색 SEARCHJOB</h1>
    {/* SNS 간편로그인 안내 (2026-11-06). 로그인한 브라우저(sj_member 표시)에서는 바로 숨깁니다.
        member.js 가 로그인 상태를 서버에 확인해 다시 맞춥니다. 「회원가입」이라는 말은 쓰지 않습니다. */}
    <div class="mem-promo" id="home-promo">
      <span class="bell" aria-hidden="true">🔔</span>
      <span><a href="/my/">SNS 간편로그인</a> 하시면 관심기업, 키워드 등 맞춤설정을 통해 새 공고를 알림으로 받을 수 있어요.</span>
    </div>
    <script is:inline>try{if(localStorage.getItem('sj_member')==='1')document.getElementById('home-promo').hidden=true;}catch(e){}</script>
    <Fragment set:html={viewHome(D)} />
  </main>
</Base>
