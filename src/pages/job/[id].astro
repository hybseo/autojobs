---
import Base from '../../layouts/Base.astro';
import { getData, toRow } from '../../v2/data.js';
import { viewJob } from '../../v2/views.js';
import {
  JOBS, jobPostingSchema, daysLeft, byCompany,
  openJobs, isRecentlyClosed, KEEP_DAYS, COLLECTED_AT,
  industriesOf, industrySlug, rolesOf, roleName, hasDetail,
  shown, stated, isUnstated, summaryOf, detailPages, isArchivedPage, isGone,
  jobTags, tagInfo, doorsOf,
} from '../../lib.js';

/*
 * 공고 상세.
 *
 * 마감된 공고도 90일간 페이지를 남깁니다.
 *
 * 예전에는 마감되면 데이터에서 빠지면서 페이지도 사라져 404 가 됐습니다.
 * 구글은 색인한 주소를 한동안 계속 방문하므로 404 가 쌓였습니다.
 * 실제로 색인 32개 중 14개가 404 였고, 전부 마감된 공고였습니다.
 *
 * 검색으로 들어온 사람을 빈손으로 돌려보내지 않고, 마감 사실을 알린 뒤
 * 같은 기업·같은 산업의 진행중 공고로 안내합니다.
 *
 * 다만 데이터에 남아 있는 동안만 가능합니다. 수집기가 마감 공고를
 * jobs.json 에서 지우면 이 페이지도 만들 수 없습니다.
 */
export function getStaticPaths() {
  return detailPages()
    .map((j) => ({ params: { id: j.id }, props: { job: j } }));
}

const { job } = Astro.props;
const site = Astro.site?.href.replace(/\/$/, '') ?? '';
const pageUrl = `${site}/job/${job.id}/`;
const d = daysLeft(job);
// 페이지가 만들어졌다는 건 요약이 있다는 뜻입니다 (hasDetail 참고).
const sum = summaryOf(job) || { gist: '', duties: [], quals: [], prefs: [], loc: '' };
// 요약이 없는 보관 페이지입니다. 검색에 내보내지 않습니다 (lib.js 주석 참고).
const archived = isArchivedPage(job);
/* 이 공고에 붙은 기술 태그. 페이지가 있는 것만 링크로 겁니다 —
   없는 주소로 보내면 404 입니다. (2026-11-02) */
const techs = jobTags(job).map((name) => ({ name, info: tagInfo(name) }));
/*
 * 마감 판정.
 *
 * d < 0 이어야 합니다. d <= 0 으로 두면 오늘 마감인 공고가 마감으로
 * 처리됩니다. daysLeft 는 마감일이 오늘이면 0 을 돌려주기 때문입니다.
 *
 * 실제로 그런 적이 있습니다. 목록에는 "오늘 마감" 으로 멀쩡히 떠 있는데
 * 눌러 들어가면 "이 공고는 마감되었습니다" 가 뜨고 지원 버튼이 사라졌습니다.
 * 아직 접수가 열려 있는 자리인데 구직자를 돌려보낸 것입니다.
 *
 * lib.js 의 openJobs 는 parseDate(closesAt) >= TODAY 로 오늘 마감을
 * 진행중으로 봅니다. 이 파일도 같은 기준이어야 합니다.
 */
const closed = d < 0 && !!job.closesAt;
const co = byCompany(job.companySlug);

// 마감된 공고는 구조화 데이터를 넣지 않습니다.
// 지원할 수 없는 자리를 채용공고로 알리면 잘못된 정보가 됩니다.
const schema = closed ? null : jobPostingSchema(job, pageUrl);

// 제목에 빈칸이 두 칸 들어 있는 공고가 38건 있습니다. <title> 에도
// 그대로 나가므로 여기서 합칩니다 (2026-11-02 최종 점검).
const title = (closed
  ? `[마감] ${job.company} ${job.title} | SEARCHJOB`
  : `${job.company} ${job.title} 채용 | SEARCHJOB`).replace(/\s+/g, ' ').trim();
/*
 * 검색 결과에 나가는 설명문.
 *
 * 2026-11-02 최종 점검에서 공고 상세 6,848쪽 중 4,957쪽(72%)의 설명문이
 * 「… 경력 · 서울.  마감.」 으로 끝나는 것을 찾았습니다. 상시채용은
 * closesAt 이 빈 문자열이라 `${job.closesAt} 마감.` 이 「 마감.」 이 되고
 * 빈칸이 두 칸 들어갑니다. 구글 검색 결과에 그대로 나가는 문장입니다.
 *
 * 그래서 조각을 먼저 모으고 빈 조각을 걸러 낸 뒤 이어 붙입니다.
 * 요약의 한 줄이 있으면 그것을 씁니다 — 사람이 읽을 문장이 제일 낫습니다.
 */
const sumGist = (sum && sum.gist || '').trim();
const descBits = [
  `${job.company} ${job.title}`,
  sumGist,
  /*
     근무지는 정리된 시·도(job.location)를 씁니다. 요약의 loc 에는 공고에
     적힌 그대로가 들어 있어 「인천 연수구 송도과학로16번길 13-39 엠씨넥스타워
     12층」 같은 전체 주소가 옵니다. 설명문은 구글이 160자쯤에서 자르므로
     주소가 요약 한 줄을 밀어냅니다. 전체 주소는 화면의 근무지 칸에 있습니다.
  */
  [stated(job.location) || null, job.career || null].filter(Boolean).join(' · ') || null,
  job.closesAt ? `${job.closesAt} 마감` : '상시채용 · 마감일 없음',
].filter(Boolean);
/*
 * 빈칸 정리는 양쪽 다 합니다.
 *
 * 공고 제목 자체에 빈칸이 두 칸 들어 있는 것이 38건 있습니다
 * (「QUALITY CONTROL 1  Team Member」·「사무보조 채용 」). 글자에서는
 * 브라우저가 알아서 합치지만 meta 설명문은 그대로 나갑니다.
 */
const tidy = (s) => s.replace(/\s+/g, ' ').trim();
const desc = closed
  ? tidy(`${job.company} ${job.title} 공고는 ${job.closesAt} 마감되었습니다. ${co.name}의 다른 진행중 공고를 확인하세요.`)
  : `${tidy(descBits.join('. '))}.`;

/*
 * 화면 (버전2 · 2026-11-03 대표님 확정)
 * ------------------------------------------------------------
 * 왼쪽에 우리 요약(한 줄 요약 · 주요 업무 · 자격 요건 · 기술 · 우대 사항 ·
 * 근무 조건), 오른쪽 기둥에 D-day · 「회사 공고로 이동」 · 점검 이력 ·
 * 「여기서 갈 수 있는 곳」. 폰에서는 마감일을 제목 밑에 두고, 지원 버튼을
 * 화면 아래에 붙여 어디까지 내려도 보이게 합니다.
 * 그리는 함수는 src/v2/views.js 의 viewJob 입니다.
 *
 * 전에 아래에 붙이던 「같은 직무 · 같은 회사 · 같은 산업 진행중 공고」
 * 목록은 확정 시안에 없어 뺐습니다. 대신 「여기서 갈 수 있는 곳」이
 * 회사·기술·직무 쪽으로 가는 링크를 겁니다 — 검색로봇이 이 쪽에서 다른
 * 쪽으로 건너가는 길은 그대로 남습니다.
 */
const D = getData();
const row = toRow(job, true);
const html = viewJob(D, row, { closed, gone: isGone(job) ? job.goneAt : '', archived });
---
<Base title={title} description={desc} schema={archived ? undefined : schema} noindex={archived} nav="jobs">
  <main class="wrap jobpage" set:html={html} />
</Base>
