---
import Base from '../../layouts/Base.astro';
import {
  JOBS, jobPostingSchema, daysLeft, byCompany,
  openJobs, isRecentlyClosed, KEEP_DAYS,
  industriesOf, industrySlug, rolesOf, roleName, hasDetail,
  shown, isUnstated, summaryOf, detailPages, isArchivedPage, isGone,
  jobTags, tagInfo,
} from '../../lib.js';

/*
 * 공고 상세.
 *
 * 마감된 공고도 90일간 페이지를 남깁니다.
 *
 * 예전에는 마감되면 데이터에서 빠지면서 페이지도 사라져 404 가 됐습니다.
 * 구글은 색인한 주소를 한동안 계속 방문하므로 404 가 쌓였습니다.
 * 실제로 색인 32개 중 14개가 404 였고, 전부 마감된 공고였습니다.
 *
 * 검색으로 들어온 사람을 빈손으로 돌려보내지 않고, 마감 사실을 알린 뒤
 * 같은 기업·같은 산업의 진행중 공고로 안내합니다.
 *
 * 다만 데이터에 남아 있는 동안만 가능합니다. 수집기가 마감 공고를
 * jobs.json 에서 지우면 이 페이지도 만들 수 없습니다.
 */
export function getStaticPaths() {
  return detailPages()
    .map((j) => ({ params: { id: j.id }, props: { job: j } }));
}

const { job } = Astro.props;
const site = Astro.site?.href.replace(/\/$/, '') ?? '';
const pageUrl = `${site}/job/${job.id}/`;
const d = daysLeft(job);
// 페이지가 만들어졌다는 건 요약이 있다는 뜻입니다 (hasDetail 참고).
const sum = summaryOf(job) || { gist: '', duties: [], quals: [], prefs: [], loc: '' };
// 요약이 없는 보관 페이지입니다. 검색에 내보내지 않습니다 (lib.js 주석 참고).
const archived = isArchivedPage(job);
/* 이 공고에 붙은 기술 태그. 페이지가 있는 것만 링크로 겁니다 —
   없는 주소로 보내면 404 입니다. (2026-11-02) */
const techs = jobTags(job).map((name) => ({ name, info: tagInfo(name) }));
/*
 * 마감 판정.
 *
 * d < 0 이어야 합니다. d <= 0 으로 두면 오늘 마감인 공고가 마감으로
 * 처리됩니다. daysLeft 는 마감일이 오늘이면 0 을 돌려주기 때문입니다.
 *
 * 실제로 그런 적이 있습니다. 목록에는 "오늘 마감" 으로 멀쩡히 떠 있는데
 * 눌러 들어가면 "이 공고는 마감되었습니다" 가 뜨고 지원 버튼이 사라졌습니다.
 * 아직 접수가 열려 있는 자리인데 구직자를 돌려보낸 것입니다.
 *
 * lib.js 의 openJobs 는 parseDate(closesAt) >= TODAY 로 오늘 마감을
 * 진행중으로 봅니다. 이 파일도 같은 기준이어야 합니다.
 */
const closed = d < 0 && !!job.closesAt;
const co = byCompany(job.companySlug);

// 마감된 공고는 구조화 데이터를 넣지 않습니다.
// 지원할 수 없는 자리를 채용공고로 알리면 잘못된 정보가 됩니다.
const schema = closed ? null : jobPostingSchema(job, pageUrl);

const title = closed
  ? `[마감] ${job.company} ${job.title} | SEARCHJOB`
  : `${job.company} ${job.title} 채용 | SEARCHJOB`;
const desc = closed
  ? `${job.company} ${job.title} 공고는 ${job.closesAt} 마감되었습니다. ${co.name}의 다른 진행중 공고를 확인하세요.`
  : `${job.company} ${job.title}. ${job.career}${job.location ? ' · ' + job.location : ''}. ${job.closesAt} 마감.`;

// 마감 화면에서 안내할 대체 공고
const inds = industriesOf(job);
const roleCodes = rolesOf(job);

/*
 * 관련 공고.
 *
 * 전에는 마감된 공고에만 보여줬습니다. 진행중일 때는 지원 버튼에
 * 집중하게 하려던 것인데, 두 가지가 아쉬웠습니다.
 *
 * 1) 검색엔진에게 막다른 길이 됩니다.
 *    구글은 링크를 타고 다니며 페이지를 찾습니다. 공고 상세에서
 *    나갈 데가 없으면 거기서 멈춥니다. 2026-09-15 서치콘솔에
 *    "발견됨 - 색인이 생성되지 않음" 이 306건 쌓여 있었습니다.
 *
 * 2) 구직자도 아쉽습니다.
 *    이 공고가 안 맞으면 그냥 뒤로 갑니다. 같은 직무 다른 공고를
 *    보여주면 한 번 더 볼 이유가 생깁니다.
 *
 * 마감된 공고에는 조금 더 보여줍니다. 지원할 수 없는 자리에 온
 * 사람에게는 대안이 본문보다 쓸모 있습니다.
 */
const LIMIT = closed ? 8 : 5;

const sameCo = openJobs()
  .filter((j) => j.companySlug === job.companySlug && j.id !== job.id)
  .slice(0, LIMIT);

/*
 * 같은 직무.
 *
 * 구직자에게 가장 쓸모 있습니다. "이 회사 다른 자리" 보다
 * "다른 회사 같은 자리" 를 찾는 경우가 많습니다.
 *
 * 같은 회사 공고는 빼고 뽑습니다. 바로 위에 이미 나오니까요.
 */
const sameRole = roleCodes.length
  ? openJobs()
      .filter((j) => j.id !== job.id
        && j.companySlug !== job.companySlug
        && rolesOf(j).some((c) => roleCodes.includes(c)))
      .slice(0, LIMIT)
  : [];

const sameInd = inds.length
  ? openJobs()
      .filter((j) => j.companySlug !== job.companySlug
        && industriesOf(j).some((x) => inds.includes(x)))
      .slice(0, LIMIT)
  : [];
const md = (s) => (s ? s.slice(5).replace('-', '.') : '');
---
<Base title={title} description={desc} schema={archived ? undefined : schema} noindex={archived}>
  <header class="mast">
    <div class="wrap">
      <div class="eyebrow"><a href={`/company/${job.companySlug}/`}>{job.company}</a></div>
      <h1>{job.title}</h1>
      {/*
        근무지는 공고가 안 알려줬으면 「제공정보 없음」으로 적습니다
        (2026-11-02 대표님 결정). 칸을 숨기면 우리가 빠뜨린 줄 알고,
        추측해서 채우면 거짓이 됩니다. 판정은 lib.js 의 shown 하나로 합니다.

        고용형태는 화면에서 뺐습니다 (2026-11-02 대표님 지시).
        공고가 고용형태를 적어 주는 곳이 드물어 거의 모든 공고에
        「제공정보 없음」만 찍혔습니다. 알려 주는 것이 없는 칸입니다.
      */}
      <div class="meta">
        <span class:list={['fact', { dim: isUnstated(job.location) }]}>
          근무지 {shown(job.location)}
        </span> ·
        {job.career} ·
        {closed
          ? <> <b class="done">마감</b> · {job.closesAt} 마감</>
          : <> <b>{d > 0 ? `D-${d}` : '오늘 마감'}</b> · {job.closesAt} 마감</>}
      </div>
    </div>
  </header>

  <main class="wrap">
    {closed && (
      <div class="closed-note">
        <b>이 공고는 마감되었습니다.</b>
        <span>{job.closesAt} 접수 마감 · 아래에서 진행중인 공고를 확인하세요.</span>
      </div>
    )}

    {/*
      회사 원문은 싣지 않습니다 (2026-11-02 대표님 지시).

      버전2 원칙은 「우리 요약이 본문, 원문은 회사 사이트로 보내는 버튼」
      입니다. 10월 28일 PC 시안에도 그렇게 적혀 있습니다 — "회사 원문은
      싣지 않습니다. 우리가 쓴 요약과 「회사 공고로 이동」 버튼이 그 자리를
      대신합니다."

      전에는 cleanBody(job.description) 을 그대로 그렸습니다. 요약을
      4,479건 써 놓고도 화면에는 원문 복사본이 나가고 있었습니다.

      페이지가 만들어지는 공고는 전부 요약이 있습니다(getStaticPaths 의
      hasDetail 이 요약 유무로 거릅니다). 그래서 여기서 요약이 없을까
      걱정하지 않아도 됩니다.
    */}
    {archived && (
      <div class="closed-note">
        <b>이 공고는 회사 채용페이지에서 내려갔습니다.</b>
        <span>{isGone(job) ? `${job.goneAt} 확인` : ''} · 아래에서 같은 기업·산업의 진행중 공고를 확인하세요.</span>
      </div>
    )}

    {sum.gist && (
      <>
        <div class="section-h">한 줄 요약</div>
        <p class="gist">{sum.gist}</p>
      </>
    )}

    {sum.duties.length > 0 && (
      <>
        <div class="section-h">주요 업무</div>
        <ul class="sumlist">{sum.duties.map((x) => <li>{x}</li>)}</ul>
      </>
    )}

    {sum.quals.length > 0 && (
      <>
        <div class="section-h">자격 요건</div>
        <ul class="sumlist">{sum.quals.map((x) => <li>{x}</li>)}</ul>
      </>
    )}

    {!archived && techs.length > 0 && (
      <>
        <div class="section-h">기술 · 도구<span class="gn">{techs.length}개 전부</span></div>
        <div class="techs">
          {techs.map(({ name, info }) => (
            info && info.link && info.slug
              ? <a class="tg" href={`/tech/${info.slug}/`}>{name}</a>
              : <span class="tg off">{name}</span>
          ))}
        </div>
      </>
    )}

    {sum.prefs.length > 0 && (
      <>
        <div class="section-h">우대 사항</div>
        <ul class="sumlist">{sum.prefs.map((x) => <li>{x}</li>)}</ul>
      </>
    )}

    {!archived && <div class="section-h">근무 조건</div>}
    {!archived && (
    <dl class="cond">
      <dt>근무지</dt><dd class:list={[{ dim: isUnstated(sum.loc || job.location) }]}>
        {shown(sum.loc || job.location)}</dd>
      <dt>경력</dt><dd>{shown(job.career)}</dd>
      <dt>마감</dt><dd>{job.closesAt ? `${job.closesAt}${closed ? ' (마감)' : ''}` : '상시 채용 · 마감일 없음'}</dd>
    </dl>)}

    {/*
      요약은 우리가 원문을 읽고 추린 것입니다. 원문이 고쳐지면 우리 요약이
      뒤처질 수 있어, 지원 전에 회사 공고를 보라고 분명히 적습니다.
    */}
    {!archived && <p class="fromsrc">이 요약은 회사 공고를 읽고 추린 것입니다. 지원 전에 회사 공고에서 원문을 확인하세요.</p>}

    {!closed && (
      <div class="prose">
        <a class="cta" href={job.sourceUrl} target="_blank" rel="noopener nofollow">회사 공고로 이동 ↗</a>
      </div>
    )}

    {sameRole.length > 0 && (
      <>
        <div class="section-h">
          같은 직무 진행중 공고
          <span class="gn">{roleCodes.map(roleName).join(' · ')}</span>
        </div>
        <ul class="archive">
          {sameRole.map((j) => (
            <li>
              <a href={hasDetail(j) ? `/job/${j.id}/` : j.sourceUrl}
                 {...(hasDetail(j) ? {} : { target: '_blank', rel: 'noopener' })}>{j.company} · {j.title}</a>
              <time>{j.closesAt ? `${md(j.closesAt)} 마감` : '상시'}</time>
            </li>
          ))}
        </ul>
        <p style="margin:10px 0 0">
          <a class="back" href={`/role/${roleCodes[0]}/`}>{roleName(roleCodes[0])} 채용 전체 보기 →</a>
        </p>
      </>
    )}

    {sameCo.length > 0 && (
      <>
        <div class="section-h">{co.name} 진행중 공고 <span class="gn">{sameCo.length}</span></div>
        <ul class="archive">
          {sameCo.map((j) => (
            <li>
              <a href={hasDetail(j) ? `/job/${j.id}/` : j.sourceUrl}
                 {...(hasDetail(j) ? {} : { target: '_blank', rel: 'noopener' })}>{j.title}</a>
              <time>{j.closesAt ? `${md(j.closesAt)} 마감` : '상시'}</time>
            </li>
          ))}
        </ul>
      </>
    )}

    {sameInd.length > 0 && (
      <>
        <div class="section-h">{inds[0]} 진행중 공고</div>
        <ul class="archive">
          {sameInd.map((j) => (
            <li>
              <a href={hasDetail(j) ? `/job/${j.id}/` : j.sourceUrl}
                 {...(hasDetail(j) ? {} : { target: '_blank', rel: 'noopener' })}>{j.company} · {j.title}</a>
              <time>{j.closesAt ? `${md(j.closesAt)} 마감` : '상시'}</time>
            </li>
          ))}
        </ul>
        <p style="margin:10px 0 0">
          <a class="back" href={`/industry/${industrySlug(inds[0])}/`}>{inds[0]} 채용 전체 보기 →</a>
        </p>
      </>
    )}

    <p style="margin:28px 0 56px">
      <a class="back" href={`/company/${job.companySlug}/`}>← {co.name} 채용 전체 보기</a>
    </p>
  </main>
</Base>

<style is:global>
  /* 마감 안내. 눈에 띄되 경고처럼 보이지는 않게 둡니다. */
  .closed-note {
    display: flex; flex-direction: column; gap: 4px;
    margin: 22px 0 4px; padding: 14px 16px;
    background: #F4F6F5; border-left: 4px solid #8A9198; border-radius: 3px;
  }
  .closed-note b { font-size: 15px; color: #16181C; }
  .closed-note span { font-size: 13.5px; color: #5A6068; }
  .mast .meta b.done { color: #B9C0C6; }
  /*
    「제공정보 없음」은 흐리게 둡니다. 적혀 있는 값과 같은 진하기로 보이면
    공고가 알려준 사실처럼 읽힙니다. 숨기지는 않습니다 — 안 적혀 있다는
    것도 구직자가 알아야 하는 정보입니다. (2026-11-02)
  */
  .mast .meta .fact.dim { color: #8A9198; }

  /* ── 요약 화면 (2026-11-02) ────────────────────────────────
     원문 대신 우리가 쓴 요약을 그립니다. 글줄은 짧게, 칸은 넓게 둡니다.
     읽는 사람이 위에서 아래로 한 번에 훑는 화면입니다. */
  .gist {
    background: var(--steel-soft, #E7EEF2);
    border-left: 3px solid var(--steel, #2D5F7C);
    padding: 15px 18px;
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--ink, #16181C);
    max-width: 62ch;
  }
  .sumlist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
    max-width: 68ch;
  }
  .sumlist li {
    position: relative;
    padding-left: 15px;
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--ink-2, #4B5158);
  }
  .sumlist li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 12px;
    width: 6px;
    height: 1px;
    background: var(--ink-3, #858B92);
  }
  .cond {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px 18px;
    margin: 0;
    font-size: 14px;
    max-width: 68ch;
  }
  .cond dt {
    font-family: var(--mono, monospace);
    font-size: 11.5px;
    color: var(--ink-3, #858B92);
    padding-top: 3px;
  }
  .cond dd { margin: 0; color: var(--ink-2, #4B5158); }
  .cond dd.dim { color: var(--ink-3, #858B92); }
  /* 기술 태그. 누르면 그 기술을 요구하는 공고로 갑니다. */
  .techs { display: flex; flex-wrap: wrap; gap: 6px; }
  .techs .tg {
    font-family: var(--mono, monospace); font-size: 12px; padding: 4px 11px;
    background: var(--steel-soft, #E7EEF2); color: var(--steel, #2D5F7C);
    text-decoration: none; border: 1px solid transparent;
  }
  .techs a.tg:hover { border-color: var(--steel, #2D5F7C); }
  /* 아직 페이지가 없는 태그. 링크로 걸지 않습니다. */
  .techs .tg.off { background: var(--surface, #F1F3F2); color: var(--ink-3, #858B92); }
  .section-h .gn { font-family: var(--mono, monospace); font-size: 11px;
                   color: var(--ink-3, #858B92); letter-spacing: 0;
                   text-transform: none; margin-left: 8px; }

  .fromsrc {
    margin-top: 22px;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--ink-3, #858B92);
    max-width: 62ch;
  }
  @media (max-width: 520px) {
    .gist { font-size: 14.5px; padding: 13px 15px; }
    .cond { grid-template-columns: 1fr; gap: 2px 0; }
    .cond dd + dt { margin-top: 10px; }
  }
</style>
