---
import Base from '../../layouts/Base.astro';
import JobCard from '../../components/JobCard.astro';
import { companies, byCompany, openJobs, closedJobs, daysLeft, parseDate, industriesOf, industrySlug } from '../../lib.js';

export function getStaticPaths() {
  return companies().map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const co = byCompany(slug);
const open = openJobs().filter((j) => j.companySlug === slug).sort((a, b) => daysLeft(a) - daysLeft(b));
const closed = closedJobs().filter((j) => j.companySlug === slug)
  .sort((a, b) => parseDate(b.closesAt) - parseDate(a.closesAt));

// 이 회사가 속한 산업. 상단 링크에 씁니다.
// 예전에는 '자동차부품 · 전장' 이 모든 기업 페이지에 박혀 있었습니다.
// 로봇·반도체가 들어온 지금은 사실과 어긋납니다.
const inds = industriesOf({ companySlug: slug });
/*
 * 검색 결과에 그대로 나가는 제목입니다.
 *
 * 예전에는 "넥센타이어 채용 · 진행중 공고 2건" 이었습니다. 세 가지가
 * 문제였습니다.
 *   1) 숫자가 낡습니다. 구글은 크롤링 시점 제목을 보여주는데, 그때 2건이던
 *      것이 지금 0건일 수 있습니다. 눌렀다가 빈 페이지를 만나면 나갑니다.
 *   2) 사이트 이름이 없어 어디인지 모릅니다. 신뢰가 안 생기니 안 누릅니다.
 *   3) "채용공고" 라는 실제 검색어가 제목에 없었습니다.
 *
 * 실제로 "넥센타이어 채용" 으로 13번 노출됐는데 클릭이 0이었습니다.
 *
 * 제목이 길면 구글이 30자쯤에서 자릅니다. 회사명이 길면 짧은 형태를 씁니다.
 */
/*
 * 처음에는 "회사명 채용공고 | 공식 채용페이지 모음 - SEARCHJOB" 으로
 * 잡았는데, 재보니 회사명이 두 글자여도 33자라 전부 잘렸습니다.
 * 잘리면 차별점("공식 채용페이지")이 검색 결과에 보이지 않습니다.
 *
 * 제목은 짧게 두고, 그 문구는 설명문 맨 앞으로 옮깁니다. 설명문은
 * 제목보다 길게 노출됩니다.
 */
const title = `${co.name} 채용공고 | SEARCHJOB`;
// 설명문에도 숫자를 넣지 않습니다. 크롤링 시점 값이 그대로 굳습니다.
const desc = `${co.name} 공식 채용페이지에 올라온 공고를 모았습니다. `
  + `모집 직무와 마감일을 확인하고 원문으로 바로 지원하세요.`;

// 기업 페이지는 ItemList 로 표시합니다. JobPosting 은 본문이 있는 상세 페이지에만 넣습니다.
const site = Astro.site?.href.replace(/\/$/, '') ?? '';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description: desc,
  about: { '@type': 'Organization', name: co.name },
  url: `${site}/company/${slug}/`,
};
---
<Base title={title} description={desc} schema={schema}>
  <header class="mast">
    <div class="wrap">
      <div class="eyebrow">
        {inds.length
          ? inds.map((n, k) => (<>{k > 0 && ' · '}<a href={`/industry/${industrySlug(n)}/`}>{n}</a></>))
          : <a href="/">전체 채용공고</a>}
      </div>
      <h1>{co.name} 채용 <em>{open.length}</em></h1>
      <div class="meta">진행중 <b>{open.length}</b>건 · 지난 채용 <b>{closed.length}</b>건</div>
    </div>
  </header>

  <main class="wrap">
    <div class="section-h">진행중인 채용</div>
    {open.length ? open.map((j) => <JobCard job={j} />) : (
      <div class="empty"><b>지금은 진행중인 공고가 없습니다</b>
        지난 채용 이력을 보시면 이 회사가 어떤 직무를 주로 뽑는지 알 수 있습니다.</div>
    )}

    <div class="section-h">이 회사는 어떤 사람을 뽑나</div>
    <div class="prose">
      <h2>채용 경향</h2>
      <p>
        이 영역은 직접 작성하세요. 자동 생성된 공고 목록만으로는 검색 노출이 어렵고,
        여기 쓰이는 현업 관점의 설명이 이 페이지를 다른 채용 사이트와 구분해 줍니다.
      </p>
      <p>
        쓸 만한 내용: 주력 제품군과 조직 구조, 최근 채용이 늘거나 준 직무,
        해당 직무의 통상 경력 요건, 면접에서 자주 확인하는 부분, 경쟁사 대비 처우 수준.
      </p>
      <a class="cta" href="#">비공개 채용 문의하기</a>
    </div>

    {closed.length > 0 && (
      <>
        <div class="section-h">지난 채용 이력</div>
        <ul class="archive">
          {closed.map((j) => (
            <li>
              <a href={j.sourceUrl} target="_blank" rel="noopener nofollow">{j.title}</a>
              <time>{j.closesAt.replace(/-/g, '.')} 마감</time>
            </li>
          ))}
        </ul>
      </>
    )}

    <p style="margin:28px 0 56px"><a class="back" href="/">← 전체 공고 보기</a></p>
  </main>
</Base>
