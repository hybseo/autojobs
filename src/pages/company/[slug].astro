---
import { getData } from '../../v2/data.js';
import { viewCompany } from '../../v2/views.js';
import Base from '../../layouts/Base.astro';
import { companyPages, byCompany, openJobs, closedJobs, daysLeft, parseDate, industriesOf, industrySlug } from '../../lib.js';

/*
 * 공고가 0건인 회사도 페이지를 남깁니다. 왜 그런지는 lib.js 의
 * companyPages 주석을 보세요. (2026-10-21)
 */
export function getStaticPaths() {
  return companyPages().map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const co = byCompany(slug);
const open = openJobs().filter((j) => j.companySlug === slug).sort((a, b) => daysLeft(a) - daysLeft(b));
const closed = closedJobs().filter((j) => j.companySlug === slug)
  .sort((a, b) => parseDate(b.closesAt) - parseDate(a.closesAt));

// 이 회사가 속한 산업. 상단 링크에 씁니다.
// 예전에는 '자동차부품 · 전장' 이 모든 기업 페이지에 박혀 있었습니다.
// 로봇·반도체가 들어온 지금은 사실과 어긋납니다.
const inds = industriesOf({ companySlug: slug });
/*
 * 검색 결과에 그대로 나가는 제목입니다.
 *
 * 예전에는 "넥센타이어 채용 · 진행중 공고 2건" 이었습니다. 세 가지가
 * 문제였습니다.
 *   1) 숫자가 낡습니다. 구글은 크롤링 시점 제목을 보여주는데, 그때 2건이던
 *      것이 지금 0건일 수 있습니다. 눌렀다가 빈 페이지를 만나면 나갑니다.
 *   2) 사이트 이름이 없어 어디인지 모릅니다. 신뢰가 안 생기니 안 누릅니다.
 *   3) "채용공고" 라는 실제 검색어가 제목에 없었습니다.
 *
 * 실제로 "넥센타이어 채용" 으로 13번 노출됐는데 클릭이 0이었습니다.
 *
 * 제목이 길면 구글이 30자쯤에서 자릅니다. 회사명이 길면 짧은 형태를 씁니다.
 */
/*
 * 처음에는 "회사명 채용공고 | 공식 채용페이지 모음 - SEARCHJOB" 으로
 * 잡았는데, 재보니 회사명이 두 글자여도 33자라 전부 잘렸습니다.
 * 잘리면 차별점("공식 채용페이지")이 검색 결과에 보이지 않습니다.
 *
 * 제목은 짧게 두고, 그 문구는 설명문 맨 앞으로 옮깁니다. 설명문은
 * 제목보다 길게 노출됩니다.
 */
const title = `${co.name} 채용공고 | SEARCHJOB`;
// 설명문에도 숫자를 넣지 않습니다. 크롤링 시점 값이 그대로 굳습니다.
const desc = `${co.name} 공식 채용페이지에 올라온 공고를 모았습니다. `
  + `모집 직무와 마감일을 확인하고 원문으로 바로 지원하세요.`;

// 기업 페이지는 ItemList 로 표시합니다. JobPosting 은 본문이 있는 상세 페이지에만 넣습니다.
const site = Astro.site?.href.replace(/\/$/, '') ?? '';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description: desc,
  about: { '@type': 'Organization', name: co.name },
  url: `${site}/company/${slug}/`,
};
/* 화면 (버전2 · 2026-11-03 대표님 확정) — src/v2/views.js 의 viewCompany 가 그립니다. */
const D = getData();
const html = viewCompany(D, slug);
---
<Base title={title} description={desc} schema={schema} nav="companies">
  <main class="wrap" set:html={html} />
</Base>
