---
import { getData } from '../../v2/data.js';
import { viewTechs } from '../../v2/views.js';
import Base from '../../layouts/Base.astro';
import { techPages, COLLECTED_AT, openJobs } from '../../lib.js';

/*
 * 기술·역량 전체 목록 (2026-11-02 새로 만듦)
 * ==========================================
 * 태그 299개를 상위 분류로 묶어 보여줍니다. 299개를 한 줄로 늘어놓으면
 * 고르는 화면이 아니라 벽이 됩니다.
 *
 * 분류 안에서는 건수 많은 순입니다. 분류끼리도 그 안의 공고 수가 많은
 * 순으로 둡니다 — 반도체 설계가 열 개 들어 있어도 건수가 적으면 아래로
 * 내려갑니다.
 */
const tags = techPages();
const total = openJobs().length;

const groups = new Map();
for (const t of tags) {
  const cat = t.cat || '기타';
  if (!groups.has(cat)) groups.set(cat, []);
  groups.get(cat).push(t);
}
const ordered = [...groups.entries()]
  .map(([cat, items]) => ({ cat, items, sum: items.reduce((a, b) => a + b.count, 0) }))
  .sort((a, b) => b.sum - a.sum);

const title = '기술·역량으로 채용공고 찾기 | SEARCHJOB';
const desc = `AUTOSAR·기능안전·반도체 설계처럼 공고가 실제로 요구하는 기술 ${tags.length}가지로 `
  + `채용공고를 찾습니다. 공고 요약에서 뽑았습니다. ${COLLECTED_AT} 기준.`;

const site = Astro.site?.href.replace(/\/$/, '') ?? '';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description: desc,
  url: `${site}/tech/`,
};
/* 화면 (버전2 · 2026-11-03 대표님 확정) — src/v2/views.js 의 viewTechs 가 그립니다. */
const D = getData();
const html = viewTechs(D);
---
<Base title={title} description={desc} schema={schema} nav="techs">
  <main class="wrap" set:html={html} />
</Base>
