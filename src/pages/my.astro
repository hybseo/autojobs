---
/*
 * 마이페이지 / 로그인 (2026-11-05)
 * =====================================================================
 * 이 파일은 빈 틀입니다. 내용은 /member.js 가 브라우저에서 그립니다.
 *   - 로그인 전: 카카오·네이버·구글 로그인 단추
 *   - 가입 직후: 이용약관·개인정보 동의
 *   - 동의 후: 알림 설정, 새 소식, 팔로우·찜·저장 검색
 *
 * 정적 파일이라 서버를 거치지 않습니다. 로그인 확인은 member.js 가 /api/me 로 합니다.
 * 검색엔진에는 내보내지 않습니다(noindex).
 */
import Base from '../layouts/Base.astro';
---
<Base
  title="마이페이지 | SEARCHJOB"
  description="팔로우한 기업과 찜한 공고의 새 소식을 확인합니다."
  noindex={true}
  nav="my"
>
  <main class="wrap mem-page">
    <div id="my"><noscript>마이페이지는 자바스크립트가 켜져 있어야 사용할 수 있습니다.</noscript></div>
  </main>
</Base>
