---
import { getData } from '../../v2/data.js';
import { viewIndustry, indLabel } from '../../v2/views.js';
import Base from '../../layouts/Base.astro';
import { industries, byIndustry, byDeadline, isAlways, COLLECTED_AT, jobTags, tagInfo } from '../../lib.js';

/*
 * 산업별 채용공고 페이지.
 *
 * companies.json 의 industry 태그에서 자동으로 만들어집니다.
 * 산업을 늘리려면 태그만 붙이면 되고, 이 파일은 고치지 않아도 됩니다.
 *
 * 메인 <title> 에서 산업명을 뺀 대신 이 페이지들이 산업 키워드를 받습니다.
 * "반도체 채용", "로봇 채용" 같은 검색이 여기로 옵니다.
 *
 * 한 회사가 여러 산업에 걸치면 그 공고는 양쪽에 모두 나옵니다.
 * 42dot 은 자동차부품이면서 IT 이고, 그 엔지니어를 찾는 사람은
 * 양쪽 어디서든 찾을 수 있어야 합니다.
 */
export function getStaticPaths() {
  return industries().map((i) => ({ params: { slug: i.slug } }));
}

const { slug } = Astro.params;
const ind = byIndustry(slug);
const jobs = [...ind.jobs].sort(byDeadline);
const cos = [...new Set(jobs.map((j) => j.company))];

/*
 * 기업 이름을 몇 개까지 먼저 보여줄지.
 *
 * IT 는 44곳, 반도체는 39곳이라 전부 펼치면 이름만 화면 두세 줄을 넘게
 * 차지하고, 정작 보러 온 공고 목록이 아래로 밀립니다. 열두 개면 두 줄
 * 정도라 "어떤 회사들이 있구나" 를 파악하기에 충분합니다.
 */
const FOLD_AT = 12;
/* 이 분야 공고가 요구하는 기술. 상위 열두 개만 보여줍니다.
   대표님 아이디어인 「태그를 타고 다른 공고로」의 입구입니다. (2026-11-02) */
const techCount = {};
for (const j of jobs) {
  for (const t of jobTags(j)) {
    const info = tagInfo(t);
    if (info && info.link && info.slug) techCount[t] = (techCount[t] || 0) + 1;
  }
}
const topTechs = Object.entries(techCount)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ko'))
  .slice(0, 12);

const alwaysN = jobs.filter(isAlways).length;
const deadlineN = jobs.length - alwaysN;

const label = indLabel(ind.name);   // 화면 이름 (자동차부품 → 자동차/자동차부품)
const title = `${label} 채용공고 | SEARCHJOB`;
const desc = `${label} 분야 기업 ${cos.length}곳의 공식 채용페이지에 올라온 공고를 모았습니다. `
  + `흩어진 채용정보를 한눈에 검색하고 원문으로 바로 이동하세요.`;

const site = Astro.site?.href.replace(/\/$/, '') ?? '';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description: desc,
  url: `${site}/industry/${slug}/`,
};
/* 화면 (버전2 · 2026-11-03 대표님 확정) — src/v2/views.js 의 viewIndustry 가 그립니다. */
const D = getData();
const html = viewIndustry(D, ind.name);
---
<Base title={title} description={desc} schema={schema} nav="industries">
  <main class="wrap" set:html={html} />
</Base>
