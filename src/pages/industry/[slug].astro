---
import Base from '../../layouts/Base.astro';
import JobCard from '../../components/JobCard.astro';
import { industries, byIndustry, byDeadline, isAlways, COLLECTED_AT } from '../../lib.js';

/*
 * 산업별 채용공고 페이지.
 *
 * companies.json 의 industry 태그에서 자동으로 만들어집니다.
 * 산업을 늘리려면 태그만 붙이면 되고, 이 파일은 고치지 않아도 됩니다.
 *
 * 메인 <title> 에서 산업명을 뺀 대신 이 페이지들이 산업 키워드를 받습니다.
 * "반도체 채용", "로봇 채용" 같은 검색이 여기로 옵니다.
 *
 * 한 회사가 여러 산업에 걸치면 그 공고는 양쪽에 모두 나옵니다.
 * 42dot 은 자동차부품이면서 IT 이고, 그 엔지니어를 찾는 사람은
 * 양쪽 어디서든 찾을 수 있어야 합니다.
 */
export function getStaticPaths() {
  return industries().map((i) => ({ params: { slug: i.slug } }));
}

const { slug } = Astro.params;
const ind = byIndustry(slug);
const jobs = [...ind.jobs].sort(byDeadline);
const cos = [...new Set(jobs.map((j) => j.company))];

/*
 * 기업 이름을 몇 개까지 먼저 보여줄지.
 *
 * IT 는 44곳, 반도체는 39곳이라 전부 펼치면 이름만 화면 두세 줄을 넘게
 * 차지하고, 정작 보러 온 공고 목록이 아래로 밀립니다. 열두 개면 두 줄
 * 정도라 "어떤 회사들이 있구나" 를 파악하기에 충분합니다.
 */
const FOLD_AT = 12;
const alwaysN = jobs.filter(isAlways).length;
const deadlineN = jobs.length - alwaysN;

const title = `${ind.name} 채용공고 | SEARCHJOB`;
const desc = `${ind.name} 분야 기업 ${cos.length}곳의 공식 채용페이지에 올라온 공고를 모았습니다. `
  + `흩어진 채용정보를 한눈에 검색하고 원문으로 바로 이동하세요.`;

const site = Astro.site?.href.replace(/\/$/, '') ?? '';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description: desc,
  url: `${site}/industry/${slug}/`,
};
---
<Base title={title} description={desc} schema={schema}>
  <header class="mast">
    <div class="wrap">
      <div class="eyebrow"><a href="/">전체 채용공고</a></div>
      <h1>{ind.name} 채용 <em>{jobs.length}</em></h1>
      <div class="meta">
        <b>{cos.length}</b>개사 공식 채용페이지 ·
        마감 있는 공고 <b>{deadlineN}</b>건 · 상시채용 <b>{alwaysN}</b>건 ·
        <b>{COLLECTED_AT.replace(/-/g, '.')}</b> 기준
      </div>
    </div>
  </header>

  <main class="wrap">
    <div class="section-h">이 분야 기업</div>
    <div class="chips cos" id="cos" data-open="false">
      {cos.map((n, i) => (
        <span class="chip" data-extra={i >= FOLD_AT ? 'y' : null}>{n}</span>
      ))}
    </div>
    {cos.length > FOLD_AT && (
      <button type="button" id="cos-toggle" class="cos-more"
              aria-expanded="false" aria-controls="cos">
        기업 {cos.length - FOLD_AT}곳 더 보기
      </button>
    )}

    <div class="section-h">진행중인 채용</div>
    {jobs.length ? jobs.map((j) => <JobCard job={j} />) : (
      <div class="empty"><b>지금은 진행중인 공고가 없습니다</b>
        다른 분야를 살펴보시거나 전체 목록에서 검색해 보세요.</div>
    )}

    <div class="section-h">다른 분야</div>
    <ul class="archive">
      {industries().filter((i) => i.slug !== slug).map((i) => (
        <li><a href={`/industry/${i.slug}/`}>{i.name} 채용</a><time>{i.jobs.length}건</time></li>
      ))}
    </ul>

    <p style="margin:28px 0 56px"><a class="back" href="/">← 전체 공고 보기</a></p>
  </main>
</Base>

<script>
  /*
   * 기업 이름 더 보기 / 접기.
   *
   * 자바스크립트가 막혀 있어도 이름은 모두 보입니다. 아래 CSS 가 접는 일을
   * 하는데, 그 CSS 는 data-open="false" 일 때만 적용되고 이 값은 서버가
   * 미리 넣어둡니다. 스크립트가 하는 일은 그 값을 뒤집는 것뿐입니다.
   */
  const box = document.getElementById('cos');
  const btn = document.getElementById('cos-toggle');
  if (box && btn) {
    const hidden = box.querySelectorAll('[data-extra]').length;
    btn.addEventListener('click', () => {
      const open = box.dataset.open === 'true';
      box.dataset.open = open ? 'false' : 'true';
      btn.setAttribute('aria-expanded', open ? 'false' : 'true');
      btn.textContent = open ? `기업 ${hidden}곳 더 보기` : '접기';
    });
  }
</script>

<style>
  /* 이 분야 기업 목록. 누르는 필터가 아니라 보여주기용이라 커서를 바꾸지 않습니다. */
  .chips.cos { margin-bottom: 8px; }
  .chips.cos .chip { cursor: default; }

  /* 접힌 상태에서만 뒤쪽 이름을 숨깁니다. 자바스크립트가 없으면 모두 보입니다. */
  .chips.cos[data-open="false"] .chip[data-extra] { display: none; }

  .cos-more {
    display: inline-block; margin: 0 0 8px;
    padding: 6px 12px; border: 1px solid var(--line); border-radius: 2px;
    background: var(--paper); color: var(--ink);
    font-family: var(--mono); font-size: 12.5px; cursor: pointer;
  }
  .cos-more:hover { border-color: var(--steel); color: var(--steel); }
</style>
