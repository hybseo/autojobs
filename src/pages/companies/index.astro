---
import { getData } from '../../v2/data.js';
import { viewCompanies } from '../../v2/views.js';
import Base from '../../layouts/Base.astro';
import {
  companyPages, openJobs, closedJobs, isRecentlyClosed,
  COLLECTED_AT, industriesOf, industrySlug,
} from '../../lib.js';

/*
 * 기업 목록 (2026-11-02 새로 만듦)
 * ================================
 * 기업 상세(/company/{slug}/)는 있는데 그 목록이 없었습니다. 425개사를
 * 매일 확인하고 있다는 사실이 사이트 어디에도 드러나지 않았습니다.
 *
 * 「공고 없음」을 숨기지 않고 셉니다
 * ----------------------------------
 * 확인은 하고 있는데 지금 뽑는 자리가 없다는 것도 정보입니다. 숨기면
 * 「425곳을 본다」는 말이 「공고가 있는 곳만 본다」로 줄어듭니다.
 * 지원아가 "549/552개 확인" 을 그대로 보여주는 것과 같은 이유입니다.
 *
 * 정렬 세 가지는 자바스크립트로 바꿉니다. 처음 그려지는 것은 공고 많은
 * 순이고, 스크립트가 막혀 있어도 목록은 그대로 보입니다.
 */
const open = openJobs();
const recentlyClosed = closedJobs().filter(isRecentlyClosed);

const openBy = {};
const freshBy = {};
const closedBy = {};
const indBy = {};
for (const j of open) {
  openBy[j.companySlug] = (openBy[j.companySlug] || 0) + 1;
  if ((j.firstSeenAt || '').slice(0, 10) === COLLECTED_AT) {
    freshBy[j.companySlug] = (freshBy[j.companySlug] || 0) + 1;
  }
  if (!indBy[j.companySlug]) indBy[j.companySlug] = industriesOf(j);
}
for (const j of recentlyClosed) closedBy[j.companySlug] = (closedBy[j.companySlug] || 0) + 1;

const rows = companyPages().map((c) => ({
  slug: c.slug,
  name: c.name,
  open: openBy[c.slug] || 0,
  fresh: freshBy[c.slug] || 0,
  closed: closedBy[c.slug] || 0,
  inds: indBy[c.slug] || [],
})).sort((a, b) => b.open - a.open || a.name.localeCompare(b.name, 'ko'));

const hiring = rows.filter((r) => r.open > 0).length;
const empty = rows.length - hiring;

// 산업 칩 — 기업 수 기준.
const indCount = {};
for (const r of rows) for (const n of r.inds) indCount[n] = (indCount[n] || 0) + 1;
const inds = Object.entries(indCount).sort((a, b) => b[1] - a[1]);

const title = '매일 확인하는 기업 | SEARCHJOB';
const desc = `${rows.length}개 기업의 공식 채용페이지를 하루 두 번 확인합니다. `
  + `지금 뽑는 기업 ${hiring}곳, 공고 없는 기업 ${empty}곳. ${COLLECTED_AT} 기준.`;

const site = Astro.site?.href.replace(/\/$/, '') ?? '';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description: desc,
  url: `${site}/companies/`,
};
/* 화면 (버전2 · 2026-11-03 대표님 확정) — src/v2/views.js 의 viewCompanies 가 그립니다. */
const D = getData();
const html = viewCompanies(D);
---
<Base title={title} description={desc} schema={schema} nav="companies">
  <main class="wrap" set:html={html} />
</Base>

<script>
  /* 기업 목록: 정렬 · 산업 칩 · 검색창 — 서버가 그려 둔 줄을 그 자리에서 고릅니다. */
  const rows = document.getElementById('coRows');
  const count = document.getElementById('coCount');
  const qbox = document.getElementById('q');
  let ind = '';
  let q = '';
  const all = rows ? [...rows.children] : [];
  const apply = () => {
    let n = 0;
    for (const r of all) {
      const ok = (!ind || (r.dataset.ind || '').split('|').includes(ind))
        && (!q || (r.dataset.n || '').includes(q));
      r.hidden = !ok;
      if (ok) n += 1;
    }
    if (count) count.textContent = `${n.toLocaleString('ko-KR')}개사`;
  };
  document.addEventListener('click', (e) => {
    const s = e.target.closest('[data-sort]');
    if (s && rows) {
      const k = s.getAttribute('data-sort');
      document.querySelectorAll('[data-sort]').forEach((b) => b.setAttribute('aria-pressed', String(b === s)));
      const name = (r) => r.querySelector('.nm').firstChild.textContent.trim();
      all.sort((a, b) => (k === 'new' ? (b.dataset.w - a.dataset.w) || (b.dataset.o - a.dataset.o)
        : k === 'ko' ? name(a).localeCompare(name(b), 'ko')
          : (b.dataset.o - a.dataset.o) || name(a).localeCompare(name(b), 'ko')));
      all.forEach((r) => rows.appendChild(r));
      return;
    }
    const c = e.target.closest('button.chip[data-ind]');
    if (c) {
      const v = c.getAttribute('data-ind');
      ind = ind === v ? '' : v;
      document.querySelectorAll('button.chip[data-ind]').forEach((b) => b.setAttribute('aria-pressed', String(b.getAttribute('data-ind') === ind)));
      apply();
    }
  });
  /* 이 쪽의 검색창은 기업을 거릅니다. Enter 를 치면 공고 검색으로 넘어갑니다. */
  if (qbox) qbox.addEventListener('input', () => { q = qbox.value.trim().toLowerCase(); apply(); });
</script>
